---
import BaseLayout from "../layouts/BaseLayout.astro";

const stats = [
  { value: "5+ ans", label: "D'expérience tech & web" },
  { value: "15+", label: "Projets & SaaS livrés" },
  { value: "3x plus vite", label: "Grâce aux workflows IA" },
  { value: "100%", label: "Orienté impact & rentabilité" },
];

const skills = [
  {
    category: "Frontend & UI",
    icon: "💻",
    items: ["React", "Astro", "Vue.js", "TypeScript", "Tailwind CSS", "Next.js"],
  },
  {
    category: "Backend & Données",
    icon: "⚙️",
    items: ["Node.js", "Python", "Supabase", "PostgreSQL", "REST APIs", "PlpgSQL"],
  },
  {
    category: "DevOps & Cloud",
    icon: "☁️",
    items: ["Docker", "Vercel", "Firebase", "CI/CD", "Linux", "Architecture Cloud"],
  },
  {
    category: "IA, Scraping & Automation",
    icon: "🤖",
    items: ["Gemini API", "Claude / GPT-4", "Prompt Engineering", "Chrome Extensions", "Scraping Web", "Workflows RPA"],
  },
];

const currentProjects = [
  {
    name: "Malmeu Tech Blog & Bancs d'Essai",
    description: "Le blog tech de référence en Algérie : comparatifs smartphones, tests laptops développeur, guides freelancing et analyses d'écosystème.",
    status: "Actif & En production",
    badgeColor: "emerald",
    link: "/blog",
  },
  {
    name: "Simulateur TJM Freelance Algérie",
    description: "Outil interactif pour calculer son revenu net réel, statut auto-entrepreneur, cotisations CASNOS et taux de change bancaire/parallèle.",
    status: "En ligne",
    badgeColor: "cyan",
    link: "/simulateur",
  },
  {
    name: "Annuaire Made in DZ Tech",
    description: "La vitrine collaborative des logiciels, SaaS, plateformes et outils innovants propulsés par des créateurs algériens.",
    status: "Communautaire",
    badgeColor: "amber",
    link: "/made-in-dz",
  },
  {
    name: "Micro-SaaS B2B & Automatisation",
    description: "Développement d'outils SaaS verticaux d'automatisation des processus pour PME et professionnels au Maghreb.",
    status: "En R&D",
    badgeColor: "purple",
  },
];

// Portfolio vérifié et nettoyé
const portfolio = [
  {
    name: "FoodForce",
    description: "Plateforme RH et recrutement connectant les talents de la restauration et de l'hôtellerie avec les meilleurs établissements.",
    url: "https://www.foodforce.ma/",
    image: "https://i.postimg.cc/W3CN6PGq/Capture-d-e-cran-2025-12-12-a-15-04-14.png",
    tags: ["TypeScript", "Node.js", "Supabase", "Tailwind CSS"],
  },
  {
    name: "CV Diali",
    description: "Générateur intelligent de CV optimisés avec designs modernes, formats d'exportation adaptés au marché nord-américain et francophone.",
    url: "https://cvdiali.com",
    image: "https://i.postimg.cc/HkZf794b/Capture-d-e-cran-2025-12-12-a-15-05-39.png",
    tags: ["React", "DaisyUI", "Supabase", "TypeScript"],
  },
  {
    name: "ALPHAS Pompes",
    description: "Vitrine technique et portail de services industriels pour la maintenance, réparation et installation d'équipements de pompage.",
    url: "https://alphas-nine.vercel.app",
    image: "https://i.postimg.cc/Ss5jK9jn/Capture-d-e-cran-2025-12-12-a-15-09-41.png",
    tags: ["Vue.js", "Python", "PostgreSQL", "Vercel"],
  },
  {
    name: "CarRent (CARMA)",
    description: "Solution SaaS de gestion de flotte automobile : suivi en temps réel des réservations, maintenance, contrats et facturation.",
    url: "https://car-manager-ten.vercel.app/",
    image: "https://i.postimg.cc/Pr4szwkt/Capture-d-e-cran-2025-12-12-a-15-47-56.png",
    tags: ["TypeScript", "Firebase", "Tailwind CSS"],
  },
  {
    name: "Gouraya Froid",
    description: "Catalogue numérique et plateforme de présentation des équipements de froid industriel, climatisation et génie frigorifique en Algérie.",
    url: "https://gouraya-froid.vercel.app/",
    image: "https://i.postimg.cc/yYZGN3L1/Capture-d-e-cran-2025-12-12-a-16-26-51.png",
    tags: ["TypeScript", "Supabase", "Tailwind CSS"],
  },
  {
    name: "Lunatech DZ",
    description: "Plateforme digitale sur-mesure pour la gestion des opérations technologiques, suivi de services IT et automatisation interne.",
    url: "https://project-luna-ten.vercel.app/",
    image: "https://i.postimg.cc/mZtXdp1n/Capture-d-e-cran-2025-12-12-a-16-45-13.png",
    tags: ["JavaScript", "PostgreSQL", "Tailwind CSS"],
  },
];

const socialLinks = [
  {
    name: "GitHub",
    label: "github.com/Malmeu",
    href: "https://github.com/Malmeu",
    icon: "M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z",
  },
  {
    name: "LinkedIn",
    label: "Sofiane Boudjada",
    href: "https://www.linkedin.com/in/sofiane-boudjada-a9960512b/",
    icon: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  },
  {
    name: "ComeUp",
    label: "comeup.com/@sofianeboudjada",
    href: "https://comeup.com/fr/@sofianeboudjada",
    icon: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z",
  },
];
---

<BaseLayout
  title="À propos | Sofiane Boudjada (Malmeu) - Développeur Full-Stack & Maker IA"
  description="Développeur full-stack et entrepreneur tech basé à Béjaïa en Algérie 🇩🇿 Spécialisé en React, Astro, Node.js, intégrations d'IA et création de SaaS rentables."
>
  <div class="max-w-5xl mx-auto px-4 py-12">
    <!-- ============================================== -->
    <!-- HERO SECTION MODERNE AVEC GLOW ET MASCOTTE    -->
    <!-- ============================================== -->
    <header class="relative mb-16 p-6 sm:p-12 rounded-3xl bg-gradient-to-br from-[var(--color-bg-secondary)] via-[var(--color-bg-secondary)]/90 to-[var(--color-bg)] border border-[var(--color-border)] shadow-2xl overflow-hidden text-center">
      <!-- Glows d'ambiance -->
      <div class="absolute -top-24 -left-24 w-80 h-80 bg-[var(--color-accent)]/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -right-24 w-80 h-80 bg-[var(--color-accent-orange)]/15 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Mascotte avec bulle interactive -->
      <div class="relative w-44 h-44 mx-auto mb-6 group cursor-pointer" id="about-mascot-container" title="Ronronne... Cliquez-moi !">
        <div id="about-cat-bubble" class="absolute -top-10 left-1/2 -translate-x-1/2 whitespace-nowrap bg-[var(--color-bg-secondary)] text-[var(--color-text)] border border-[var(--color-accent)]/40 px-3.5 py-1.5 rounded-2xl shadow-xl text-xs font-semibold opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none z-20 flex items-center gap-1.5">
          <span>🐾</span> <span>Salut ! Bienvenue chez Malmeu</span>
        </div>
        <div class="w-44 h-44 overflow-hidden rounded-full border-2 border-[var(--color-accent)]/30 bg-black/20 shadow-inner flex items-center justify-center">
          <lottie-player
            src="/Sleeping_cat.json"
            background="transparent"
            speed="1"
            style="width: 300px; height: 300px; margin-left: -65px; margin-top: -55px;"
            loop
            autoplay
          ></lottie-player>
        </div>
      </div>

      <!-- Badges de statut -->
      <div class="flex flex-wrap items-center justify-center gap-2 mb-4">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-emerald-500/10 text-emerald-400 border border-emerald-500/25 rounded-full text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          Disponible pour missions & SaaS
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-[var(--color-bg)] text-[var(--color-text-muted)] border border-[var(--color-border)] rounded-full text-xs font-medium">
          📍 Béjaïa, Algérie 🇩🇿
        </span>
      </div>

      <!-- Nom & Titre -->
      <h1 class="text-3xl sm:text-5xl font-extrabold text-[var(--color-text)] tracking-tight mb-4">
        Sofiane Boudjada <span class="text-transparent bg-clip-text bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-orange)]">(Malmeu)</span>
      </h1>

      <p class="text-base sm:text-xl text-[var(--color-text-muted)] max-w-2xl mx-auto leading-relaxed mb-8">
        Développeur Full-Stack & Maker Tech. Je conçois des produits web modernes, des architectures avec l'IA et des solutions business rentables adaptées au marché local et international.
      </p>

      <!-- Boutons d'actions rapides -->
      <div class="flex flex-wrap justify-center items-center gap-3">
        <a
          href="/contact"
          class="px-6 py-3 bg-gradient-to-r from-[var(--color-accent)] to-teal-500 text-[var(--color-bg)] font-bold text-sm rounded-xl shadow-lg shadow-[var(--color-accent)]/20 hover:opacity-95 hover:scale-[1.02] transition-all"
        >
          👋 Me contacter
        </a>
        <a
          href="/simulateur"
          class="px-5 py-3 bg-[var(--color-bg)] border border-[var(--color-border)] text-[var(--color-text)] font-semibold text-sm rounded-xl hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-all"
        >
          🧮 Simuler un TJM Freelance
        </a>
        <a
          href="#portfolio"
          class="px-5 py-3 bg-[var(--color-bg)] border border-[var(--color-border)] text-[var(--color-text)] font-semibold text-sm rounded-xl hover:border-[var(--color-accent-orange)] hover:text-[var(--color-accent-orange)] transition-all"
        >
          🚀 Voir les réalisations
        </a>
      </div>
    </header>

    <!-- ============================================== -->
    <!-- STATS RAPIDES                                  -->
    <!-- ============================================== -->
    <section class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16">
      {stats.map(s => (
        <div class="p-5 rounded-2xl bg-[var(--color-bg-secondary)] border border-[var(--color-border)] text-center">
          <div class="text-2xl sm:text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-orange)]">
            {s.value}
          </div>
          <div class="text-xs font-medium text-[var(--color-text-muted)] mt-1">
            {s.label}
          </div>
        </div>
      ))}
    </section>

    <!-- ============================================== -->
    <!-- HISTOIRE & PHILOSOPHIE (BENTO STORY)           -->
    <!-- ============================================== -->
    <section class="mb-16">
      <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--color-accent)] mb-2">
        <span>📖</span> Mon histoire & vision
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-[var(--color-text)] mb-8">
        Du code utile, du pragmatisme et zéro jargon inutile
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
        <!-- Carte 1 : Parcours & Mission -->
        <div class="md:col-span-7 p-6 sm:p-8 rounded-3xl bg-[var(--color-bg-secondary)] border border-[var(--color-border)] flex flex-col justify-between space-y-4">
          <div>
            <span class="text-3xl mb-3 block">💡</span>
            <h3 class="text-xl font-bold text-[var(--color-text)] mb-3">
              Créer pour résoudre de vrais blocages
            </h3>
            <div class="space-y-3 text-sm text-[var(--color-text-muted)] leading-relaxed">
              <p>
                Mon parcours de développeur a commencé par un constat évident en Algérie : trop d'entreprises, d'indépendants et d'artisans sont freinés par des outils informatiques désuets, des logiciels lourds ou des tarifs inaccessibles.
              </p>
              <p>
                Plutôt que d'attendre des solutions toutes faites d'ailleurs, j'ai choisi de construire. Mon objectif quotidien n'est pas seulement d'empiler du code, mais de livrer des plateformes rapides, des systèmes de gestion fiables et des interfaces qui font gagner du temps et de l'argent.
              </p>
            </div>
          </div>
          <div class="pt-4 border-t border-[var(--color-border)] flex items-center gap-3 text-xs text-[var(--color-text-muted)]">
            <span class="text-emerald-400 font-bold">✓ Esprit Maker</span>
            <span>•</span>
            <span class="text-cyan-400 font-bold">✓ Livraison rapide</span>
            <span>•</span>
            <span class="text-amber-400 font-bold">✓ Sans dette technique</span>
          </div>
        </div>

        <!-- Carte 2 : IA & Productivité -->
        <div class="md:col-span-5 p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-indigo-950/30 to-purple-950/20 border border-indigo-500/30 flex flex-col justify-between space-y-4">
          <div>
            <span class="text-3xl mb-3 block">⚡</span>
            <h3 class="text-xl font-bold text-indigo-200 mb-3">
              Développement assisté par IA
            </h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
              L'IA n'est pas une menace mais un accélérateur redoutable. J'utilise quotidiennement les outils les plus avancés (Windsurf, Cursor, Antigravity, LLMs spécialisés) pour prototyper, tester et déployer des MVP en un tiers du temps habituellement nécessaire.
            </p>
          </div>
          <div class="p-4 rounded-xl bg-black/40 border border-indigo-500/20 text-xs text-indigo-300 font-mono">
            <code>Stack de prédilection: Astro + React + Supabase + TypeScript</code>
          </div>
        </div>

        <!-- Carte 3 : Les 3 Piliers de mon travail -->
        <div class="md:col-span-12 grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-5 rounded-2xl bg-[var(--color-bg-secondary)] border border-[var(--color-border)]">
            <div class="text-2xl mb-2">🚀</div>
            <h4 class="font-bold text-sm text-[var(--color-text)] mb-1">Applications Web & SaaS</h4>
            <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
              De l'idée au produit final hébergé, prêt pour les premiers utilisateurs avec gestion des abonnements et base de données sécurisée.
            </p>
          </div>
          <div class="p-5 rounded-2xl bg-[var(--color-bg-secondary)] border border-[var(--color-border)]">
            <div class="text-2xl mb-2">🔄</div>
            <h4 class="font-bold text-sm text-[var(--color-text)] mb-1">Automatisation & Scraping</h4>
            <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
              Extensions de navigateur, robots de collecte de données et pipelines automatisés pour éliminer les tâches manuelles répétitives.
            </p>
          </div>
          <div class="p-5 rounded-2xl bg-[var(--color-bg-secondary)] border border-[var(--color-border)]">
            <div class="text-2xl mb-2">🇩🇿</div>
            <h4 class="font-bold text-sm text-[var(--color-text)] mb-1">Conseil & Écosystème DZ</h4>
            <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
              Compréhension aiguë des réalités locales : paiement électronique (CIB/Edahabia), conversion devise, marché informel et auto-entrepreneuriat.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================== -->
    <!-- COMPÉTENCES TECHNIQUES (STACK MATRIX)          -->
    <!-- ============================================== -->
    <section class="mb-16">
      <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--color-accent)] mb-2">
        <span>🛠️</span> Stack & Technologies
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-[var(--color-text)] mb-8">
        Les outils que je maîtrise au quotidien
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {skills.map((skill) => (
          <div class="p-6 rounded-2xl bg-[var(--color-bg-secondary)] border border-[var(--color-border)] hover:border-[var(--color-accent)]/40 transition-colors">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-2xl">{skill.icon}</span>
              <h3 class="font-bold text-base text-[var(--color-text)]">
                {skill.category}
              </h3>
            </div>
            <div class="flex flex-wrap gap-2">
              {skill.items.map((item) => (
                <span class="px-3 py-1.5 bg-[var(--color-bg)] text-[var(--color-text)] border border-[var(--color-border)] hover:border-[var(--color-accent)]/50 rounded-xl text-xs font-medium transition-colors">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ============================================== -->
    <!-- PROJETS EN COURS & ROADMAP                     -->
    <!-- ============================================== -->
    <section class="mb-16">
      <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--color-accent)] mb-2">
        <span>📌</span> Projets actuels
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-[var(--color-text)] mb-8">
        Sur quoi je travaille en ce moment
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {currentProjects.map((p) => (
          <div class="p-6 rounded-2xl bg-[var(--color-bg-secondary)] border border-[var(--color-border)] flex flex-col justify-between gap-4">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <h3 class="font-bold text-base text-[var(--color-text)]">
                  {p.name}
                </h3>
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 shrink-0">
                  {p.status}
                </span>
              </div>
              <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed">
                {p.description}
              </p>
            </div>
            {p.link && (
              <div>
                <a 
                  href={p.link} 
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--color-accent)] hover:underline"
                >
                  <span>Accéder au projet</span>
                  <span>→</span>
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- ============================================== -->
    <!-- PORTFOLIO / RÉALISATIONS                       -->
    <!-- ============================================== -->
    <section id="portfolio" class="mb-16 scroll-mt-20">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-8">
        <div>
          <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--color-accent)] mb-2">
            <span>💼</span> Réalisations concrètes
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-[var(--color-text)]">
            Portfolio & Projets Déployés
          </h2>
        </div>
        <p class="text-xs sm:text-sm text-[var(--color-text-muted)] max-w-sm">
          Aperçu de plateformes, SaaS et sites vitrines conçus pour des clients ou créés en interne.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {portfolio.map((project) => (
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col justify-between bg-[var(--color-bg-secondary)] border border-[var(--color-border)] rounded-2xl overflow-hidden hover:border-[var(--color-accent)] transition-all duration-300 hover:shadow-xl hover:shadow-[var(--color-accent)]/10"
          >
            <div>
              <div class="relative aspect-video overflow-hidden bg-black/40 border-b border-[var(--color-border)]">
                <img
                  src={project.image}
                  alt={project.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute top-2.5 right-2.5 px-2 py-1 rounded-md bg-black/70 backdrop-blur-md text-[10px] font-bold text-white border border-white/10 opacity-0 group-hover:opacity-100 transition-opacity">
                  Visiter ↗
                </div>
              </div>

              <div class="p-5">
                <h3 class="font-bold text-base text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors mb-2">
                  {project.name}
                </h3>
                <p class="text-xs text-[var(--color-text-muted)] leading-relaxed mb-4 line-clamp-3">
                  {project.description}
                </p>
                <div class="flex flex-wrap gap-1.5">
                  {project.tags.map((tag) => (
                    <span class="px-2 py-0.5 bg-[var(--color-bg)] text-[var(--color-accent)] border border-[var(--color-border)] rounded-md text-[10px] font-medium">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <div class="p-5 pt-0">
              <div class="flex items-center text-xs font-semibold text-[var(--color-accent)] group-hover:translate-x-1 transition-transform">
                <span>Voir la plateforme en ligne</span>
                <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ============================================== -->
    <!-- RÉSEAUX & ME CONTACTER                         -->
    <!-- ============================================== -->
    <section class="mb-16 text-center">
      <div class="flex items-center justify-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--color-accent)] mb-2">
        <span>🌐</span> Réseaux & Profils Publics
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-[var(--color-text)] mb-6">
        Où me retrouver
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-2xl mx-auto">
        {socialLinks.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-2xl bg-[var(--color-bg-secondary)] border border-[var(--color-border)] hover:border-[var(--color-accent)] hover:scale-[1.02] transition-all flex items-center gap-3 text-left group"
          >
            <div class="w-10 h-10 rounded-xl bg-[var(--color-bg)] border border-[var(--color-border)] flex items-center justify-center text-[var(--color-accent)] group-hover:bg-[var(--color-accent)] group-hover:text-black transition-colors shrink-0">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d={s.icon} />
              </svg>
            </div>
            <div class="truncate">
              <div class="text-xs font-bold text-[var(--color-text)]">{s.name}</div>
              <div class="text-[11px] text-[var(--color-text-muted)] truncate">{s.label}</div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ============================================== -->
    <!-- CTA TRAVAILLONS ENSEMBLE                       -->
    <!-- ============================================== -->
    <section class="relative overflow-hidden p-8 sm:p-12 rounded-3xl bg-gradient-to-r from-[var(--color-accent)]/15 via-[var(--color-bg-secondary)] to-[var(--color-accent-orange)]/15 border border-[var(--color-accent)]/30 text-center shadow-xl">
      <div class="max-w-2xl mx-auto space-y-4">
        <span class="text-3xl block">🤝</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--color-text)]">
          Un projet tech ou un SaaS à lancer ?
        </h2>
        <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed">
          Que vous ayez besoin d'un développement complet, d'une intégration d'IA personnalisée, d'un MVP rapide ou de conseils techniques pour votre entreprise en Algérie, échangeons dès aujourd'hui.
        </p>
        <div class="pt-2 flex flex-wrap justify-center gap-3">
          <a
            href="/contact"
            class="px-6 py-3 bg-[var(--color-accent)] text-[var(--color-bg)] rounded-xl font-bold text-sm hover:opacity-90 hover:scale-105 transition-all shadow-lg shadow-[var(--color-accent)]/20"
          >
            Envoyer un message direct
          </a>
          <a
            href="https://comeup.com/fr/@sofianeboudjada"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 bg-[var(--color-bg)] border border-[var(--color-border)] text-[var(--color-text)] rounded-xl font-semibold text-sm hover:border-[var(--color-accent)] transition-all"
          >
            Commander via ComeUp
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

