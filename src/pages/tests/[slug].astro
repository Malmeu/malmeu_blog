---
import { getCollection } from 'astro:content';
import TestLayout from '../../layouts/TestLayout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const tests = await getCollection('tests', ({ data }) => !data.draft);
  const sortedTests = tests.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
  
  return sortedTests.map((test, index) => ({
    params: { slug: test.slug },
    props: { 
      test,
      prevTest: sortedTests[index + 1] || null,
      nextTest: sortedTests[index - 1] || null,
    },
  }));
}

const { test, prevTest, nextTest } = Astro.props;
const { Content, headings } = await test.render();
---

<TestLayout test={test} headings={headings} prevTest={prevTest} nextTest={nextTest}>
  <Content />
</TestLayout>
