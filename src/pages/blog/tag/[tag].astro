---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  
  // Extraire tous les tags uniques
  const tagMap = new Map<string, typeof posts>();
  
  posts.forEach(post => {
    if (Array.isArray(post.data.tags)) {
      post.data.tags.forEach(rawTag => {
        const normalizedTag = rawTag.trim().toLowerCase();
        if (normalizedTag) {
          if (!tagMap.has(normalizedTag)) {
            tagMap.set(normalizedTag, []);
          }
          tagMap.get(normalizedTag)!.push(post);
        }
      });
    }
  });

  const allUniqueTags = Array.from(tagMap.keys());

  return Array.from(tagMap.entries()).map(([tag, taggedPosts]) => ({
    params: { tag },
    props: {
      tagName: tag,
      allTags: allUniqueTags,
      posts: taggedPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()),
    },
  }));
}

const { tagName, allTags, posts } = Astro.props;
---

<BaseLayout 
  title={`Articles sur #${tagName} | Malmeu Blog`}
  description={`Tous les articles, retours d'expérience et conseils tagués avec #${tagName} sur le blog de Malmeu.`}
>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <!-- Breadcrumbs -->
    <nav class="mb-8 text-sm" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-[var(--color-text-muted)] flex-wrap">
        <li><a href="/" class="hover:text-[var(--color-accent)] transition-colors">Accueil</a></li>
        <li>/</li>
        <li><a href="/blog" class="hover:text-[var(--color-accent)] transition-colors">Blog</a></li>
        <li>/</li>
        <li><span class="text-[var(--color-text-muted)]">Tags</span></li>
        <li>/</li>
        <li class="text-[var(--color-accent)] font-medium">#{tagName}</li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-[var(--color-accent)]/10 text-[var(--color-accent)] rounded-full text-sm font-medium mb-4">
        <span>🏷️</span> Tag thématique
      </div>
      <h1 class="text-4xl md:text-5xl font-bold text-[var(--color-text)] mb-4">
        Articles sur <span class="text-[var(--color-accent)]">#{tagName}</span>
      </h1>
      <p class="text-xl text-[var(--color-text-muted)]">
        {posts.length} article{posts.length > 1 ? 's' : ''} disponible{posts.length > 1 ? 's' : ''} sur ce thème.
      </p>
    </header>

    <!-- Posts Grid -->
    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <BlogCard 
            title={post.data.title}
            description={post.data.description}
            publishDate={post.data.publishDate}
            category={post.data.category}
            image={post.data.image}
            slug={post.slug}
            tags={post.data.tags}
            sponsored={post.data.sponsored}
            sponsorName={post.data.sponsorName}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-20 bg-[var(--color-bg-secondary)] rounded-xl">
        <p class="text-[var(--color-text-muted)]">Aucun article avec ce tag pour le moment.</p>
      </div>
    )}

    <!-- Other Tags (Internal Linking Hub) -->
    {allTags && allTags.length > 1 && (
      <section class="mt-16 pt-12 border-t border-[var(--color-bg-secondary)]">
        <h2 class="text-lg font-semibold text-[var(--color-text)] mb-4">
          Explorer d'autres thématiques :
        </h2>
        <div class="flex flex-wrap gap-2">
          {allTags
            .filter(t => t !== tagName)
            .map((t) => (
              <a 
                href={`/blog/tag/${t}`}
                class="px-3 py-1.5 bg-[var(--color-bg-secondary)] text-[var(--color-text-muted)] hover:text-[var(--color-accent)] hover:bg-[var(--color-accent)]/10 rounded-lg text-sm transition-colors"
              >
                #{t}
              </a>
            ))}
        </div>
      </section>
    )}

    <!-- Back to Blog -->
    <div class="mt-12 text-center">
      <a 
        href="/blog"
        class="inline-block px-6 py-3 bg-[var(--color-bg-secondary)] text-[var(--color-text)] rounded-lg hover:bg-[var(--color-accent)]/20 transition-colors"
      >
        ← Tous les articles du blog
      </a>
    </div>
  </div>
</BaseLayout>
