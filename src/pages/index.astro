---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import PopularPosts from '../components/PopularPosts.astro';
import { getCollection } from 'astro:content';

// Get all posts
const allPosts = await getCollection('blog', ({ data }) => !data.draft);

// Get featured posts
const featuredPosts = allPosts
  .filter(post => post.data.featured)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

// Get recent posts (excluding featured)
const recentPosts = allPosts
  .filter(post => !post.data.featured)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 6);

// Get recent tech tests
const allTests = await getCollection('tests', ({ data }) => !data.draft);
const recentTests = allTests
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

// Helper function to calculate reading time
const calculateReadingTime = (content: string) => {
  const wordsPerMinute = 200;
  const words = content.split(/\s+/).length;
  return Math.ceil(words / wordsPerMinute);
};

const categories = [
  { name: 'Dev Web', slug: 'dev-web', icon: '💻', description: 'Développement frontend et backend' },
  { name: 'IA-ML', slug: 'ia-ml', icon: '🤖', description: 'Intelligence artificielle et Machine Learning' },
  { name: 'SaaS', slug: 'saas', icon: '☁️', description: 'Software as a Service et produits' },
  { name: 'Business', slug: 'business', icon: '📈', description: 'Entrepreneuriat et stratégie' },
  { name: 'Algérie Tech', slug: 'algerie-tech', icon: '🇩🇿', description: 'Écosystème tech algérien' },
];
---

<BaseLayout 
  title="Malmeu | Blog Tech Algérie - Développement Web, IA & SaaS"
  description="Blog tech depuis l'Algérie 🇩🇿 Tutoriels développement web, intelligence artificielle, création de SaaS et entrepreneuriat tech. Conseils pratiques pour développeurs."
>
  <!-- Hero Section -->
  <section class="relative py-20 px-4 overflow-hidden">
    <!-- Arrière-plan Technologique & Cyber Grid -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden select-none" aria-hidden="true">
      <!-- 1. Grille cybernétique avec masque radial -->
      <div 
        class="absolute inset-0 opacity-[0.18] dark:opacity-[0.25]"
        style="background-image: linear-gradient(to right, var(--color-accent) 1px, transparent 1px), linear-gradient(to bottom, var(--color-accent) 1px, transparent 1px); background-size: 40px 40px; mask-image: radial-gradient(ellipse 75% 65% at 50% 40%, black 40%, transparent 85%); -webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 40%, black 40%, transparent 85%);"
      ></div>

      <!-- 2. Motifs de micro-circuits / Points lumineux -->
      <div 
        class="absolute inset-0 opacity-[0.25] dark:opacity-[0.35]"
        style="background-image: radial-gradient(circle at 1px 1px, var(--color-accent-orange) 1px, transparent 0); background-size: 32px 32px; mask-image: radial-gradient(circle at 50% 50%, black 25%, transparent 75%); -webkit-mask-image: radial-gradient(circle at 50% 50%, black 25%, transparent 75%);"
      ></div>

      <!-- 3. Halos lumineux d'ambiance (Glowing Orbs) -->
      <div class="absolute -top-24 -left-24 w-96 h-96 bg-[var(--color-accent)]/20 rounded-full blur-[100px] animate-pulse"></div>
      <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-[var(--color-accent-orange)]/15 rounded-full blur-[120px]"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[350px] bg-[var(--color-accent)]/10 rounded-full blur-[110px]"></div>

      <!-- 4. Badges et symboles tech flottants discrets -->
      <div class="hidden md:flex absolute top-12 left-8 items-center gap-2 px-3 py-1.5 rounded-xl bg-[var(--color-bg-secondary)]/70 border border-[var(--color-accent)]/30 backdrop-blur-md text-[11px] font-mono text-[var(--color-accent)] shadow-lg animate-fade-in opacity-80">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span>stack: astro + supabase</span>
      </div>

      <div class="hidden md:flex absolute top-20 right-10 items-center gap-2 px-3 py-1.5 rounded-xl bg-[var(--color-bg-secondary)]/70 border border-[var(--color-accent-orange)]/30 backdrop-blur-md text-[11px] font-mono text-[var(--color-accent-orange)] shadow-lg animate-fade-in opacity-80">
        <span>🤖 gemini & claude llms</span>
      </div>

      <div class="hidden lg:flex absolute bottom-12 left-12 items-center gap-2 px-3 py-1.5 rounded-xl bg-[var(--color-bg-secondary)]/60 border border-emerald-500/25 backdrop-blur-md text-[11px] font-mono text-emerald-400 opacity-75">
        <span>🇩🇿 dz tech ecosystem</span>
      </div>

      <div class="hidden lg:flex absolute bottom-14 right-16 items-center gap-2 px-3 py-1.5 rounded-xl bg-[var(--color-bg-secondary)]/60 border border-cyan-500/25 backdrop-blur-md text-[11px] font-mono text-cyan-300 opacity-75">
        <span>MRR: scaling...</span>
      </div>
    </div>

    <div class="max-w-4xl mx-auto text-center relative z-10">
      <!-- Mascotte avec bulle interactive -->
      <div class="relative w-44 h-44 mx-auto mb-6 animate-fade-in group cursor-pointer" id="mascot-container" title="Cliquez-moi pour une astuce tech !">
        <div id="cat-tip-bubble" class="absolute -top-12 left-1/2 -translate-x-1/2 whitespace-nowrap bg-[var(--color-bg-secondary)] text-[var(--color-text)] border border-[var(--color-accent)]/40 px-3.5 py-1.5 rounded-2xl shadow-xl text-xs font-semibold opacity-0 transition-all duration-300 pointer-events-none z-20 flex items-center gap-1.5">
          <span>🐾</span> <span id="cat-tip-text">Ronronne... Cliquez-moi !</span>
        </div>
        <lottie-player 
          src="/Sleeping_cat.json"
          background="transparent"
          speed="1"
          style="width: 320px; height: 320px; margin-left: -70px; margin-top: -60px;"
          loop
          autoplay
        ></lottie-player>
      </div>
      <h1 class="text-4xl md:text-6xl font-bold mb-6 animate-fade-in" style="animation-delay: 0.1s;">
        <span class="text-(--color-text)">Salut, je suis </span>
        <span class="text-transparent bg-clip-text bg-linear-to-r from-(--color-accent) to-(--color-accent-orange)">
          Malmeu
        </span>
      </h1>
      <p class="text-xl text-(--color-text-muted) mb-8 max-w-2xl mx-auto animate-fade-in" style="animation-delay: 0.1s;">
        Je partage mes idées, astuces et retours d'expérience sur le développement web, l'IA, les SaaS et l'entrepreneuriat tech depuis l'Algérie.
      </p>
      <div class="flex flex-wrap justify-center gap-4 animate-fade-in" style="animation-delay: 0.2s;">
        <a 
          href="/blog" 
          class="px-6 py-3 bg-[var(--color-accent)] text-[var(--color-bg)] rounded-lg font-medium hover:opacity-90 transition-opacity"
        >
          Lire le blog
        </a>
        <a 
          href="/simulateur" 
          class="px-6 py-3 bg-gradient-to-r from-amber-500 to-orange-500 text-white rounded-lg font-medium hover:opacity-90 shadow-lg shadow-amber-500/20 transition-all"
        >
          🧮 Simulateur Freelance & SaaS
        </a>
        <a 
          href="/made-in-dz" 
          class="px-6 py-3 border border-[var(--color-accent)] text-[var(--color-accent)] rounded-lg font-medium hover:bg-[var(--color-accent)]/10 transition-colors"
        >
          🇩🇿 Made in DZ
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Posts -->
  {featuredPosts.length > 0 && (
    <section class="py-16 px-4 bg-linear-to-br from-(--color-accent)/5 to-(--color-accent-orange)/5">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-(--color-text) mb-4">
            ⭐ Articles en vedette
          </h2>
          <p class="text-lg text-(--color-text-muted) max-w-2xl mx-auto">
            Les articles les plus populaires et pertinents que vous ne voulez pas manquer.
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {featuredPosts.map((post) => (
            <FeaturedCard
              title={post.data.title}
              description={post.data.description}
              slug={post.slug}
              image={post.data.image}
              category={post.data.category}
              publishDate={post.data.publishDate}
              readingTime={calculateReadingTime(post.body)}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Section Articles Populaires (Tendances & Vues Réelles) -->
  <section class="py-6 px-4">
    <div class="max-w-6xl mx-auto">
      <PopularPosts />
    </div>
  </section>

  <!-- Recent Posts -->
  <section class="py-16 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl md:text-3xl font-bold text-(--color-text)">
          Articles récents
        </h2>
        <a 
          href="/blog" 
          class="text-(--color-accent) hover:text-(--color-accent-orange) transition-colors font-medium"
        >
          Voir tous →
        </a>
      </div>
      
      {recentPosts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {recentPosts.map((post) => (
            <BlogCard 
              title={post.data.title}
              description={post.data.description}
              publishDate={post.data.publishDate}
              category={post.data.category}
              image={post.data.image}
              slug={post.slug}
              tags={post.data.tags}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-12 bg-(--color-bg-secondary) rounded-xl">
          <p class="text-(--color-text-muted)">Aucun article pour le moment. Revenez bientôt !</p>
        </div>
      )}
    </div>
  </section>

  <!-- Section Tests & Bancs d'essai Tech -->
  {recentTests.length > 0 && (
    <section class="py-16 px-4 bg-gradient-to-b from-transparent via-[var(--color-bg-secondary)]/50 to-transparent">
      <div class="max-w-6xl mx-auto">
        <div class="flex items-center justify-between mb-8">
          <div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-bold mb-2">
              <span>⚡</span> Le Lab Hardware & Gadgets
            </div>
            <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-text)]">
              Bancs d'essai & Tests Tech
            </h2>
          </div>
          <a 
            href="/tests" 
            class="text-emerald-400 hover:text-emerald-300 font-semibold text-sm flex items-center gap-1 group"
          >
            <span>Tous les tests</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {recentTests.map((item) => (
            <article class="group relative flex flex-col rounded-2xl bg-[var(--color-bg)] border border-[var(--color-border)] hover:border-emerald-500/40 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden">
              <div class="relative aspect-16/10 overflow-hidden bg-black/40">
                <img 
                  src={item.data.image} 
                  alt={item.data.productName} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-[11px] font-bold bg-black/70 backdrop-blur-md text-white border border-white/10">
                  {item.data.brand}
                </div>
                <div class="absolute top-3 right-3 flex items-center gap-1 px-3 py-1.5 rounded-full backdrop-blur-md font-black text-sm shadow-lg border border-black/20 bg-emerald-500 text-black">
                  <span>★</span>
                  <span>{item.data.rating.toFixed(1)}</span>
                </div>
                {item.data.price && (
                  <div class="absolute bottom-3 left-3 px-2.5 py-1 rounded-lg text-xs font-bold bg-black/80 backdrop-blur-md text-emerald-400 border border-white/10">
                    💰 {item.data.price}
                  </div>
                )}
              </div>
              <div class="p-5 flex-1 flex flex-col justify-between">
                <div>
                  <div class="text-xs font-semibold text-[var(--color-accent)] mb-1">
                    {item.data.category}
                  </div>
                  <h3 class="text-base font-bold text-[var(--color-text)] group-hover:text-emerald-400 transition-colors line-clamp-2 mb-2">
                    <a href={`/tests/${item.slug}`} class="focus:outline-none">
                      <span class="absolute inset-0 z-10" aria-hidden="true"></span>
                      {item.data.title}
                    </a>
                  </h3>
                  <p class="text-xs text-[var(--color-text-muted)] line-clamp-2 leading-relaxed">
                    {item.data.description}
                  </p>
                </div>
                <div class="mt-4 pt-3 border-t border-[var(--color-border)] flex items-center justify-between text-xs font-bold text-emerald-400">
                  <span>Lire l'avis complet</span>
                  <span>→</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Categories -->
  <section class="py-16 px-4 bg-(--color-bg-secondary)">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold text-(--color-text) mb-8 text-center">
        Catégories
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {categories.map((cat) => (
          <a 
            href={`/blog/category/${cat.slug}`}
            class="group p-6 bg-(--color-bg) rounded-xl hover:shadow-lg hover:shadow-(--color-accent)/10 transition-all duration-300 hover:-translate-y-1 text-center"
          >
            <span class="text-4xl mb-4 block">{cat.icon}</span>
            <h3 class="font-semibold text-(--color-text) group-hover:text-(--color-accent) transition-colors mb-2">
              {cat.name}
            </h3>
            <p class="text-xs text-(--color-text-muted)">{cat.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-(--color-text) mb-4">
        Restons en contact
      </h2>
      <p class="text-(--color-text-muted) mb-8">
        Vous avez une question ou souhaitez collaborer ? N'hésitez pas à me contacter.
      </p>
      <a 
        href="/contact" 
        class="inline-block px-8 py-4 bg-linear-to-r from-(--color-accent) to-(--color-accent-orange) text-white rounded-lg font-medium hover:opacity-90 transition-opacity"
      >
        Me contacter
      </a>
    </div>
  </section>

  <!-- Lottie Player différé uniquement pour la mascotte de l'accueil -->
  <script is:inline defer src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>

  <script is:inline>
    (function() {
      const tips = [
        "💡 En Algérie, vendez vos SaaS B2B au forfait annuel pour sécuriser votre trésorerie !",
        "⚡ Le statut Auto-entrepreneur en Algérie ne coûte que 5% d'impôt (IFU) !",
        "🤖 Pour Nano Banana Pro & Claude : soyez ultra descriptif sur vos contextes métiers.",
        "💳 Utilisez Wise ou des cartes virtuelles dédiées pour séparer dépenses SaaS et persos.",
        "🚀 Le marché SaaS B2B en Algérie est encore vierge : digitalisez les process locaux !"
      ];

      const mascot = document.getElementById('mascot-container');
      const bubble = document.getElementById('cat-tip-bubble');
      const tipText = document.getElementById('cat-tip-text');

      if (mascot && bubble && tipText) {
        mascot.addEventListener('click', function() {
          const randomTip = tips[Math.floor(Math.random() * tips.length)];
          tipText.textContent = randomTip;
          bubble.classList.remove('opacity-0', '-top-12');
          bubble.classList.add('opacity-100', '-top-16');

          setTimeout(function() {
            bubble.classList.remove('opacity-100', '-top-16');
            bubble.classList.add('opacity-0', '-top-12');
          }, 4500);
        });
      }
    })();
  </script>
</BaseLayout>

