---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
---

<BaseLayout 
  title="Made in DZ Tech 🇩🇿 | L'annuaire des SaaS et projets créés en Algérie"
  description="Découvrez et soutenez les meilleurs projets technologiques, SaaS, outils IA et applications mobiles conçus par des développeurs et entrepreneurs algériens."
>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <!-- Breadcrumbs -->
    <nav class="mb-8 text-sm" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-[var(--color-text-muted)]">
        <li><a href="/" class="hover:text-[var(--color-accent)] transition-colors">Accueil</a></li>
        <li>/</li>
        <li><span class="text-[var(--color-text-muted)]">Communauté</span></li>
        <li>/</li>
        <li class="text-[var(--color-accent)] font-medium">Made in DZ</li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 rounded-full text-xs font-semibold uppercase tracking-wider mb-4">
        <span>🇩🇿</span> Écosystème & Créateurs Tech DZ
      </div>
      <h1 class="text-3xl md:text-5xl font-bold text-[var(--color-text)] mb-4">
        L'annuaire <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-[var(--color-accent)]">Made in DZ Tech</span>
      </h1>
      <p class="text-lg text-[var(--color-text-muted)] mb-8">
        La vitrine collaborative des SaaS, applications et outils propulsés par des talents algériens. Découvrez, testez et soutenez les bâtisseurs tech locaux.
      </p>

      <button 
        id="open-submit-modal-btn"
        class="px-6 py-3 bg-gradient-to-r from-emerald-500 to-teal-500 text-white font-semibold rounded-xl shadow-lg shadow-emerald-500/20 hover:opacity-95 transition-all cursor-pointer inline-flex items-center gap-2"
      >
        <span>🚀</span> Soumettre un projet (+ Gratuit)
      </button>
    </header>

    <!-- Filtres & Recherche -->
    <div class="flex flex-col md:flex-row gap-4 items-center justify-between mb-8 pb-6 border-b border-[var(--color-bg-secondary)]">
      <!-- Filtres par catégorie -->
      <div class="flex flex-wrap gap-2" id="category-filters">
        <button class="filter-btn active px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-[var(--color-accent)] text-[var(--color-bg)] transition-colors" data-category="all">
          Tous
        </button>
        <button class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-[var(--color-bg-secondary)] text-[var(--color-text-muted)] hover:text-white transition-colors" data-category="SaaS B2B">
          SaaS B2B
        </button>
        <button class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-[var(--color-bg-secondary)] text-[var(--color-text-muted)] hover:text-white transition-colors" data-category="IA & ML">
          IA & ML
        </button>
        <button class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-[var(--color-bg-secondary)] text-[var(--color-text-muted)] hover:text-white transition-colors" data-category="E-commerce & Paiement">
          Paiement & E-commerce
        </button>
        <button class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-[var(--color-bg-secondary)] text-[var(--color-text-muted)] hover:text-white transition-colors" data-category="Dev Tools">
          Dev Tools
        </button>
        <button class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-[var(--color-bg-secondary)] text-[var(--color-text-muted)] hover:text-white transition-colors" data-category="Mobile">
          Mobile
        </button>
      </div>

      <!-- Recherche instantanée -->
      <div class="relative w-full md:w-64">
        <input 
          type="text" 
          id="project-search" 
          placeholder="Rechercher un SaaS..." 
          class="w-full px-3.5 py-2 pl-9 bg-[var(--color-bg-secondary)] border border-[var(--color-bg-tertiary)] rounded-xl text-xs text-[var(--color-text)] placeholder-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-accent)]"
        />
        <svg class="w-4 h-4 text-[var(--color-text-muted)] absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
    </div>

    <!-- Grille des projets -->
    <div id="projects-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="col-span-full py-12 text-center text-[var(--color-text-muted)]">
        Chargement des projets Made in DZ...
      </div>
    </div>

    <!-- Modal de soumission -->
    <div id="submit-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm">
      <div class="bg-[var(--color-bg-secondary)] border border-[var(--color-bg-tertiary)] rounded-2xl max-w-lg w-full p-6 md:p-8 shadow-2xl relative">
        <button id="close-modal-btn" class="absolute top-4 right-4 text-[var(--color-text-muted)] hover:text-white text-xl">
          ✕
        </button>

        <h3 class="text-xl font-bold text-[var(--color-text)] mb-2 flex items-center gap-2">
          <span>🚀</span> Soumettre votre projet
        </h3>
        <p class="text-xs text-[var(--color-text-muted)] mb-6">
          Votre projet sera examiné et publié gratuitement dans l'annuaire Made in DZ Tech.
        </p>

        <form id="project-submit-form" class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-[var(--color-text)] mb-1">Nom du SaaS / Produit *</label>
            <input type="text" id="form-name" required placeholder="Ex: MonSuperSaaS" class="w-full px-3 py-2 bg-[var(--color-bg)] border border-[var(--color-bg-tertiary)] rounded-xl text-sm text-[var(--color-text)] focus:outline-none focus:border-[var(--color-accent)]" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-[var(--color-text)] mb-1">Lien du site Web / App *</label>
            <input type="url" id="form-url" required placeholder="https://monsupersaas.dz" class="w-full px-3 py-2 bg-[var(--color-bg)] border border-[var(--color-bg-tertiary)] rounded-xl text-sm text-[var(--color-text)] focus:outline-none focus:border-[var(--color-accent)]" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-[var(--color-text)] mb-1">Pitch court (1 phrase) *</label>
            <input type="text" id="form-tagline" required placeholder="Ex: Solution de facturation automatisée pour indépendants en Algérie" class="w-full px-3 py-2 bg-[var(--color-bg)] border border-[var(--color-bg-tertiary)] rounded-xl text-sm text-[var(--color-text)] focus:outline-none focus:border-[var(--color-accent)]" />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-[var(--color-text)] mb-1">Catégorie *</label>
              <select id="form-category" required class="w-full px-3 py-2 bg-[var(--color-bg)] border border-[var(--color-bg-tertiary)] rounded-xl text-xs text-[var(--color-text)] focus:outline-none">
                <option value="SaaS B2B">SaaS B2B</option>
                <option value="IA & ML">IA & ML</option>
                <option value="E-commerce & Paiement">E-commerce & Paiement</option>
                <option value="Dev Tools">Dev Tools</option>
                <option value="Mobile">Mobile</option>
                <option value="Autre">Autre</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-[var(--color-text)] mb-1">Nom du créateur / équipe</label>
              <input type="text" id="form-creator" placeholder="Ex: Karim B." class="w-full px-3 py-2 bg-[var(--color-bg)] border border-[var(--color-bg-tertiary)] rounded-xl text-sm text-[var(--color-text)] focus:outline-none" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-[var(--color-text)] mb-1">Twitter / X ou LinkedIn (Optionnel)</label>
            <input type="text" id="form-social" placeholder="@VotreHandle ou profil" class="w-full px-3 py-2 bg-[var(--color-bg)] border border-[var(--color-bg-tertiary)] rounded-xl text-sm text-[var(--color-text)] focus:outline-none" />
          </div>

          <div id="form-feedback" class="text-xs hidden p-3 rounded-xl"></div>

          <button 
            type="submit" 
            id="form-submit-btn"
            class="w-full py-2.5 bg-gradient-to-r from-emerald-500 to-teal-500 text-white font-semibold rounded-xl hover:opacity-90 transition-opacity text-sm cursor-pointer"
          >
            Envoyer ma candidature
          </button>
        </form>
      </div>
    </div>

    <!-- Newsletter -->
    <div class="mt-16">
      <Newsletter />
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function() {
    let allProjects = [];
    let currentCategory = 'all';
    let searchQuery = '';

    const container = document.getElementById('projects-container');
    const searchInput = document.getElementById('project-search');
    const filterButtons = document.querySelectorAll('.filter-btn');

    // Chargement des projets via API
    function fetchProjects() {
      fetch('/api/community-projects')
        .then(res => res.json())
        .then(data => {
          allProjects = data || [];
          renderProjects();
        })
        .catch(() => {
          container.innerHTML = '<div class="col-span-full py-12 text-center text-red-400">Erreur lors du chargement des projets.</div>';
        });
    }

    function renderProjects() {
      const filtered = allProjects.filter(project => {
        const matchesCategory = currentCategory === 'all' || project.category === currentCategory;
        const matchesSearch = searchQuery === '' || 
          project.name.toLowerCase().includes(searchQuery.toLowerCase()) || 
          project.tagline.toLowerCase().includes(searchQuery.toLowerCase());
        return matchesCategory && matchesSearch;
      });

      if (filtered.length === 0) {
        container.innerHTML = '<div class="col-span-full py-16 text-center text-[var(--color-text-muted)] bg-[var(--color-bg-secondary)] rounded-2xl p-8"><p class="text-lg font-medium text-[var(--color-text)] mb-2">Aucun projet trouvé</p><p class="text-sm">Soyez le premier à soumettre un projet dans cette catégorie !</p></div>';
        return;
      }

      container.innerHTML = filtered.map(project => {
        return `
          <div class="group relative flex flex-col justify-between p-6 bg-[var(--color-bg-secondary)] border border-[var(--color-bg-tertiary)] hover:border-[var(--color-accent)]/40 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-[var(--color-accent)]/15 text-[var(--color-accent)]">
                  ${project.category}
                </span>
                <span class="text-xs text-[var(--color-text-muted)] font-medium">
                  🇩🇿 DZ
                </span>
              </div>
              <h3 class="text-xl font-bold text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors mb-2">
                ${project.name}
              </h3>
              <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-4">
                ${project.tagline}
              </p>
            </div>

            <div class="pt-4 border-t border-[var(--color-bg-tertiary)] flex items-center justify-between text-xs">
              <span class="text-[var(--color-text-muted)] truncate max-w-[140px]">
                Par <strong class="text-[var(--color-text)]">${project.creator_name || 'DZ Dev'}</strong>
              </span>
              <a 
                href="${project.url}" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-1 font-semibold text-[var(--color-accent)] hover:underline"
              >
                Visiter le site <span>→</span>
              </a>
            </div>
          </div>
        `;
      }).join('');
    }

    // Filtrage catégories
    filterButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        filterButtons.forEach(b => {
          b.className = 'filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-[var(--color-bg-secondary)] text-[var(--color-text-muted)] hover:text-white transition-colors';
        });
        this.className = 'filter-btn active px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-[var(--color-accent)] text-[var(--color-bg)] transition-colors';
        currentCategory = this.getAttribute('data-category');
        renderProjects();
      });
    });

    // Recherche
    searchInput.addEventListener('input', function(e) {
      searchQuery = e.target.value.trim();
      renderProjects();
    });

    // Modal
    const modal = document.getElementById('submit-modal');
    const openModalBtn = document.getElementById('open-submit-modal-btn');
    const closeModalBtn = document.getElementById('close-modal-btn');
    const form = document.getElementById('project-submit-form');
    const feedback = document.getElementById('form-feedback');

    openModalBtn.addEventListener('click', () => modal.classList.remove('hidden'));
    closeModalBtn.addEventListener('click', () => modal.classList.add('hidden'));

    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.classList.add('hidden');
    });

    // Soumission Formulaire
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      const submitBtn = document.getElementById('form-submit-btn');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Envoi en cours...';

      const payload = {
        name: document.getElementById('form-name').value,
        url: document.getElementById('form-url').value,
        tagline: document.getElementById('form-tagline').value,
        category: document.getElementById('form-category').value,
        creator_name: document.getElementById('form-creator').value,
        creator_twitter: document.getElementById('form-social').value,
      };

      fetch('/api/community-projects', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
        .then(res => res.json())
        .then(data => {
          feedback.classList.remove('hidden');
          if (data.success) {
            feedback.className = 'text-xs p-3 rounded-xl bg-emerald-500/15 text-emerald-400 border border-emerald-500/30';
            feedback.textContent = data.message || 'Projet soumis avec succès !';
            form.reset();
            setTimeout(() => {
              modal.classList.add('hidden');
              feedback.classList.add('hidden');
            }, 3000);
          } else {
            feedback.className = 'text-xs p-3 rounded-xl bg-rose-500/15 text-rose-400 border border-rose-500/30';
            feedback.textContent = data.error || 'Une erreur est survenue.';
          }
        })
        .catch(() => {
          feedback.classList.remove('hidden');
          feedback.className = 'text-xs p-3 rounded-xl bg-rose-500/15 text-rose-400 border border-rose-500/30';
          feedback.textContent = 'Erreur de connexion au serveur.';
        })
        .finally(() => {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Envoyer ma candidature';
        });
    });

    fetchProjects();
  })();
</script>
