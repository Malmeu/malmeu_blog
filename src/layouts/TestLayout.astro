---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Comments from '../components/Comments.astro';
import ShareButtons from '../components/ShareButtons.astro';
import Newsletter from '../components/Newsletter.astro';
import PostReactions from '../components/PostReactions.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  test: CollectionEntry<'tests'>;
  headings: { depth: number; slug: string; text: string }[];
  prevTest?: CollectionEntry<'tests'>;
  nextTest?: CollectionEntry<'tests'>;
}

const { test, headings, prevTest, nextTest } = Astro.props;
const {
  title,
  description,
  publishDate,
  productName,
  brand,
  category,
  tags = [],
  image,
  price,
  priceCurrency = 'DZD',
  priceRaw,
  rating,
  verdict,
  award,
  testedPeriod,
  pros,
  cons,
  ratingsBreakdown,
  specs,
  buyUrl,
  buyLabel = 'Voir la disponibilité / prix',
  author = 'Malmeu',
  authorImage,
  authorBio,
} = test.data;

// Détection et traitement spécial du mode comparatif
const isComparison = category?.toLowerCase().includes('comparatif') || 
                     tags?.some(t => t.toLowerCase().includes('comparatif')) ||
                     productName.toLowerCase().includes(' vs ');

// Données découpées pour le mode comparatif
let compData = {
  rivalA: {
    name: 'iPhone Duo',
    brand: 'Apple',
    brandColor: 'indigo',
    price: '',
    pros: [] as string[],
    cons: [] as string[],
  },
  rivalB: {
    name: 'Galaxy Z Fold 8',
    brand: 'Samsung',
    brandColor: 'cyan',
    price: '',
    pros: [] as string[],
    cons: [] as string[],
  },
  commonPros: [] as string[],
  commonCons: [] as string[],
  specs: [] as { key: string; valA: string; valB: string; raw: string }[],
};

if (isComparison) {
  // Noms des rivaux
  const vsParts = productName.split(/\s+vs\s+/i);
  if (vsParts.length >= 2) {
    compData.rivalA.name = vsParts[0].trim();
    compData.rivalB.name = vsParts[1].trim();
  } else {
    compData.rivalA.name = productName;
  }

  // Marques
  const brandParts = brand.split(/\s*[\/\-]\s*|\s+vs\s+/i);
  if (brandParts.length >= 2) {
    compData.rivalA.brand = brandParts[0].trim();
    compData.rivalB.brand = brandParts[1].trim();
  } else {
    compData.rivalA.brand = brand;
  }

  // Prix
  if (price.includes('|')) {
    const priceParts = price.split('|');
    compData.rivalA.price = priceParts[0].trim();
    compData.rivalB.price = priceParts[1].trim();
  } else {
    compData.rivalA.price = price;
    compData.rivalB.price = price;
  }

  // Pros & Cons
  pros.forEach((pro) => {
    const lower = pro.toLowerCase();
    if (lower.startsWith(compData.rivalA.name.toLowerCase()) || lower.includes('iphone duo :') || lower.includes('iphone :') || lower.includes('apple :')) {
      compData.rivalA.pros.push(pro.replace(/^[^:]+:\s*/i, ''));
    } else if (lower.startsWith(compData.rivalB.name.toLowerCase()) || lower.includes('galaxy z fold 8 :') || lower.includes('z fold 8 :') || lower.includes('samsung :') || lower.includes('fold 8 :')) {
      compData.rivalB.pros.push(pro.replace(/^[^:]+:\s*/i, ''));
    } else {
      compData.commonPros.push(pro);
    }
  });

  cons.forEach((con) => {
    const lower = con.toLowerCase();
    if (lower.startsWith(compData.rivalA.name.toLowerCase()) || lower.includes('iphone duo :') || lower.includes('iphone :') || lower.includes('apple :')) {
      compData.rivalA.cons.push(con.replace(/^[^:]+:\s*/i, ''));
    } else if (lower.startsWith(compData.rivalB.name.toLowerCase()) || lower.includes('galaxy z fold 8 :') || lower.includes('z fold 8 :') || lower.includes('samsung :') || lower.includes('fold 8 :')) {
      compData.rivalB.cons.push(con.replace(/^[^:]+:\s*/i, ''));
    } else {
      compData.commonCons.push(con);
    }
  });

  // Specs
  if (specs) {
    Object.entries(specs).forEach(([key, val]) => {
      if (val.includes(' vs ')) {
        const [rawA, rawB] = val.split(/\s+vs\s+/i);
        const cleanA = rawA.replace(/\s*\((?:Duo|iPhone|Apple)[^)]*\)/i, '').trim();
        const cleanB = rawB.replace(/\s*\((?:Fold\s*8|Fold8|Samsung|Galaxy)[^)]*\)/i, '').trim();
        compData.specs.push({
          key,
          valA: cleanA || rawA.trim(),
          valB: cleanB || rawB.trim(),
          raw: val,
        });
      } else {
        compData.specs.push({
          key,
          valA: val,
          valB: val,
          raw: val,
        });
      }
    });
  }
}

// Temps de lecture
const content = test.body || '';
const wordCount = content.split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 200);

const siteUrl = Astro.site?.toString() || 'https://www.malmeu.info';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

// Calcul du cercle SVG pour la note sur 10 (r = 42, circonférence = 264)
const circumference = 264;
const strokeDashoffset = circumference - (circumference * (rating / 10));

// Données structurées Schema.org pour Google Product & Review Rich Snippets
const productReviewSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": productName,
  "image": ogImageURL.toString(),
  "description": description,
  "brand": {
    "@type": "Brand",
    "name": brand
  },
  "offers": {
    "@type": "Offer",
    "priceCurrency": priceCurrency,
    "price": priceRaw || parseFloat(price.replace(/[^\d.]/g, '')) || 0,
    "availability": "https://schema.org/InStock",
    "url": buyUrl || canonicalURL.toString()
  },
  "review": {
    "@type": "Review",
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": rating,
      "bestRating": 10,
      "worstRating": 0
    },
    "author": {
      "@type": "Person",
      "name": author,
      "url": siteUrl
    },
    "datePublished": publishDate.toISOString(),
    "dateModified": publishDate.toISOString(),
    "reviewBody": description,
    "positiveNotes": {
      "@type": "ItemList",
      "itemListElement": pros.map((pro, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": pro
      }))
    },
    "negativeNotes": {
      "@type": "ItemList",
      "itemListElement": cons.map((con, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": con
      }))
    }
  }
};

const testBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Tests Tech",
      "item": `${siteUrl}/tests`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": productName,
      "item": canonicalURL.toString()
    }
  ]
};
---

<BaseLayout 
  title={`${title} | Banc d'essai Tech`}
  description={description}
  image={image}
  type="article"
  publishDate={publishDate}
  tags={tags}
  category={category}
  readingTime={readingTime}
  wordCount={wordCount}
>
  <!-- Schema.org Product & Review Rich Snippets -->
  <script type="application/ld+json" set:html={JSON.stringify(productReviewSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(testBreadcrumbSchema)} />

  <!-- Barre de progression de lecture -->
  <div id="reading-progress-bar" class="fixed top-0 left-0 h-1 bg-gradient-to-r from-emerald-400 via-[var(--color-accent)] to-cyan-400 z-50 transition-all duration-75" style="width: 0%;"></div>

  <!-- Barre d'outils Mode Zen -->
  <div id="zen-toolbar" class="fixed top-4 right-4 z-50 hidden items-center gap-2 p-2 bg-[var(--color-bg-secondary)]/90 backdrop-blur-md border border-[var(--color-accent)]/30 rounded-2xl shadow-2xl">
    <button id="zen-font-down" class="px-2.5 py-1 text-xs font-bold bg-[var(--color-bg)] text-[var(--color-text)] rounded-lg hover:bg-[var(--color-accent)]/20 cursor-pointer" title="Diminuer la police">A-</button>
    <button id="zen-font-up" class="px-2.5 py-1 text-xs font-bold bg-[var(--color-bg)] text-[var(--color-text)] rounded-lg hover:bg-[var(--color-accent)]/20 cursor-pointer" title="Agrandir la police">A+</button>
    <button id="zen-exit-btn" class="px-3 py-1 text-xs font-semibold bg-rose-500/20 text-rose-300 border border-rose-500/30 rounded-lg hover:bg-rose-500/30 cursor-pointer" title="Quitter (Échap)">✕ Quitter Zen</button>
  </div>

  <article class="max-w-4xl mx-auto px-4 py-8">
    <!-- Fil d'ariane -->
    <nav class="flex items-center gap-2 text-xs text-[var(--color-text-muted)] mb-6 overflow-x-auto whitespace-nowrap">
      <a href="/" class="hover:text-[var(--color-accent)] transition-colors">Accueil</a>
      <span>/</span>
      <a href="/tests" class="hover:text-[var(--color-accent)] transition-colors">Tests Tech</a>
      <span>/</span>
      <span class="text-[var(--color-text)] truncate">{productName}</span>
    </nav>

    <!-- Header & Titre -->
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        {isComparison ? (
          <span class="px-3.5 py-1 text-xs font-bold rounded-full bg-gradient-to-r from-indigo-500/20 via-purple-500/20 to-cyan-500/20 text-cyan-300 border border-cyan-500/40 flex items-center gap-1.5 shadow-sm">
            ⚔️ Grand Comparatif Tech
          </span>
        ) : (
          <span class="px-3 py-1 text-xs font-semibold rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            ⚡ Banc d'essai
          </span>
        )}
        <span class="px-3 py-1 text-xs font-medium rounded-full bg-[var(--color-bg-secondary)] text-[var(--color-text-muted)] border border-[var(--color-border)]">
          {category}
        </span>
        {award && (
          <span class="px-3 py-1 text-xs font-bold rounded-full bg-amber-500/15 text-amber-300 border border-amber-500/30 flex items-center gap-1">
            🏆 {award}
          </span>
        )}
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--color-text)] leading-tight mb-4 tracking-tight">
        {title}
      </h1>

      <p class="text-lg text-[var(--color-text-muted)] leading-relaxed mb-6">
        {description}
      </p>

      <!-- Métadonnées & Auteur -->
      <div class="flex flex-wrap items-center justify-between gap-4 py-4 border-y border-[var(--color-border)] text-sm text-[var(--color-text-muted)]">
        <div class="flex items-center gap-3">
          <img 
            src={authorImage || '/malmcat2.webp'} 
            alt={author} 
            class="w-10 h-10 rounded-full border border-[var(--color-accent)]/30 object-cover"
          />
          <div>
            <div class="font-semibold text-[var(--color-text)]">{author}</div>
            <div class="text-xs">
              Publié le {publishDate.toLocaleDateString('fr-DZ', { year: 'numeric', month: 'long', day: 'numeric' })}
            </div>
          </div>
        </div>

        <div class="flex items-center gap-4 text-xs">
          <span class="flex items-center gap-1 bg-[var(--color-bg-secondary)] px-2.5 py-1 rounded-md">
            ⏱️ {readingTime} min de lecture
          </span>
          <span class="flex items-center gap-1 bg-[var(--color-bg-secondary)] px-2.5 py-1 rounded-md text-emerald-400">
            🧪 {testedPeriod}
          </span>
          <button id="zen-toggle-btn" class="hidden sm:inline-flex items-center gap-1 text-[var(--color-accent)] hover:underline cursor-pointer">
            🧘 Mode Zen
          </button>
        </div>
      </div>
    </header>

    <!-- ============================================== -->
    <!-- HERO BENTO SCORECARD (Mise en page Innovante) -->
    <!-- ============================================== -->
    {isComparison ? (
      <!-- MISE EN PAGE SPÉCIALE COMPARATIF (FACE-À-FACE) -->
      <section class="mb-12 relative overflow-hidden rounded-3xl p-5 sm:p-8 bg-gradient-to-br from-[var(--color-bg-secondary)] via-[var(--color-bg-secondary)]/90 to-[var(--color-bg)] border border-[var(--color-border)] shadow-2xl">
        <!-- Glows d'ambiance dynamiques -->
        <div class="absolute -top-24 -left-24 w-80 h-80 bg-indigo-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-80 h-80 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>

        <!-- 1. Bannière Face-à-Face / Duel -->
        <div class="relative z-10 mb-8">
          <!-- Carte d'affiche Duel avec image -->
          <div class="relative w-full aspect-16/9 sm:aspect-21/9 rounded-2xl overflow-hidden border border-[var(--color-border)] shadow-lg bg-black/50 group mb-6">
            <img 
              src={image} 
              alt={productName}
              class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-black/40"></div>
            
            <div class="absolute top-3 left-3 flex flex-wrap gap-2">
              <span class="px-3 py-1 bg-black/75 backdrop-blur-md rounded-full text-xs font-semibold text-white border border-white/10">
                {brand}
              </span>
              <span class="px-3 py-1 bg-indigo-600/80 backdrop-blur-md rounded-full text-xs font-bold text-white border border-indigo-400/30">
                Le Grand Duel
              </span>
            </div>

            <!-- VS Badge central flottant -->
            <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
              <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-black/80 backdrop-blur-xl border-2 border-cyan-400/50 flex items-center justify-center shadow-2xl shadow-cyan-500/30">
                <span class="text-base sm:text-lg font-black bg-gradient-to-r from-indigo-300 via-white to-cyan-300 bg-clip-text text-transparent tracking-wider">
                  VS
                </span>
              </div>
            </div>

            <!-- Titres des deux rivaux sur l'image -->
            <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between gap-2 text-white">
              <div class="max-w-[45%]">
                <span class="inline-block text-[10px] sm:text-xs font-bold text-indigo-300 uppercase tracking-wider mb-0.5">
                  {compData.rivalA.brand || 'Apple'}
                </span>
                <h3 class="text-sm sm:text-lg font-extrabold leading-tight drop-shadow-md">
                  {compData.rivalA.name}
                </h3>
              </div>
              <div class="max-w-[45%] text-right">
                <span class="inline-block text-[10px] sm:text-xs font-bold text-cyan-300 uppercase tracking-wider mb-0.5">
                  {compData.rivalB.brand || 'Samsung'}
                </span>
                <h3 class="text-sm sm:text-lg font-extrabold leading-tight drop-shadow-md">
                  {compData.rivalB.name}
                </h3>
              </div>
            </div>
          </div>

          <!-- Cartes Tarifs Comparés Algérie -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
            <div class="p-3.5 rounded-xl bg-indigo-950/25 border border-indigo-500/25 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-indigo-400"></span>
                <span class="text-xs font-bold text-[var(--color-text)]">{compData.rivalA.name}</span>
              </div>
              <span class="text-xs font-bold text-indigo-300">
                {compData.rivalA.price || price}
              </span>
            </div>
            <div class="p-3.5 rounded-xl bg-cyan-950/25 border border-cyan-500/25 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
                <span class="text-xs font-bold text-[var(--color-text)]">{compData.rivalB.name}</span>
              </div>
              <span class="text-xs font-bold text-cyan-300">
                {compData.rivalB.price || price}
              </span>
            </div>
          </div>

          <!-- Verdict de la Rédaction avec Jauge -->
          <div class="p-5 rounded-2xl bg-[var(--color-bg)]/80 border border-[var(--color-border)] flex flex-col md:flex-row items-center gap-6">
            <div class="relative flex items-center justify-center shrink-0">
              <svg class="w-24 h-24 transform -rotate-90" viewBox="0 0 100 100">
                <circle cx="50" cy="50" r="42" class="stroke-white/10" stroke-width="8" fill="transparent" />
                <circle 
                  cx="50" cy="50" r="42" 
                  class="stroke-cyan-400 transition-all duration-1000 ease-out" 
                  stroke-width="8" 
                  stroke-linecap="round" 
                  fill="transparent" 
                  stroke-dasharray={circumference} 
                  stroke-dashoffset={strokeDashoffset} 
                />
              </svg>
              <div class="absolute inset-0 flex flex-col items-center justify-center">
                <span class="text-2xl font-black text-[var(--color-text)] tracking-tight">{rating.toFixed(1)}</span>
                <span class="text-[9px] font-semibold text-[var(--color-text-muted)] uppercase">Note globale</span>
              </div>
            </div>

            <div class="space-y-2 text-center md:text-left flex-1">
              <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-cyan-500/10 text-cyan-400 text-xs font-bold uppercase tracking-wider">
                ⚖️ Verdict du Face-à-Face
              </div>
              <h3 class="text-lg sm:text-xl font-bold text-[var(--color-text)]">
                {rating >= 8.5 ? '⭐ Un match serré d\'un niveau exceptionnel' : '👍 Deux approches radicalement différentes'}
              </h3>
              <p class="text-xs sm:text-sm text-[var(--color-text-muted)] italic leading-relaxed">
                « {verdict} »
              </p>
            </div>
          </div>
        </div>

        <!-- 2. Bento Duel : Points Forts & Points Faibles séparés par appareil -->
        <div class="mt-8 pt-8 border-t border-[var(--color-border)]">
          <div class="flex items-center justify-between mb-4">
            <h4 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-[var(--color-text-muted)]">
              ⚔️ Duel des Forces & Faiblesses
            </h4>
            <span class="text-[11px] text-[var(--color-text-muted)]">Analyse comparée</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <!-- Colonne Rival A (ex: iPhone Duo) -->
            <div class="p-5 rounded-2xl bg-indigo-950/20 border border-indigo-500/30 flex flex-col gap-4">
              <div class="flex items-center justify-between pb-3 border-b border-indigo-500/20">
                <div class="flex items-center gap-2">
                  <span class="text-base">🍎</span>
                  <span class="font-extrabold text-sm sm:text-base text-indigo-300">{compData.rivalA.name}</span>
                </div>
                <span class="text-[11px] font-semibold px-2 py-0.5 rounded bg-indigo-500/20 text-indigo-300">
                  {compData.rivalA.brand}
                </span>
              </div>

              <!-- Pros Rival A -->
              {compData.rivalA.pros.length > 0 && (
                <div>
                  <div class="text-xs font-bold text-emerald-400 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                    <span>✓</span> Points forts
                  </div>
                  <ul class="space-y-2">
                    {compData.rivalA.pros.map(pro => (
                      <li class="flex items-start gap-2 text-xs sm:text-sm text-[var(--color-text)]">
                        <span class="text-emerald-400 font-bold shrink-0 mt-0.5">✓</span>
                        <span class="leading-snug">{pro}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <!-- Cons Rival A -->
              {compData.rivalA.cons.length > 0 && (
                <div class="pt-3 border-t border-indigo-500/15">
                  <div class="text-xs font-bold text-rose-400 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                    <span>✕</span> Points faibles
                  </div>
                  <ul class="space-y-2">
                    {compData.rivalA.cons.map(con => (
                      <li class="flex items-start gap-2 text-xs sm:text-sm text-[var(--color-text)]">
                        <span class="text-rose-400 font-bold shrink-0 mt-0.5">✕</span>
                        <span class="leading-snug">{con}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

            <!-- Colonne Rival B (ex: Galaxy Z Fold 8) -->
            <div class="p-5 rounded-2xl bg-cyan-950/20 border border-cyan-500/30 flex flex-col gap-4">
              <div class="flex items-center justify-between pb-3 border-b border-cyan-500/20">
                <div class="flex items-center gap-2">
                  <span class="text-base">🔷</span>
                  <span class="font-extrabold text-sm sm:text-base text-cyan-300">{compData.rivalB.name}</span>
                </div>
                <span class="text-[11px] font-semibold px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300">
                  {compData.rivalB.brand}
                </span>
              </div>

              <!-- Pros Rival B -->
              {compData.rivalB.pros.length > 0 && (
                <div>
                  <div class="text-xs font-bold text-emerald-400 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                    <span>✓</span> Points forts
                  </div>
                  <ul class="space-y-2">
                    {compData.rivalB.pros.map(pro => (
                      <li class="flex items-start gap-2 text-xs sm:text-sm text-[var(--color-text)]">
                        <span class="text-emerald-400 font-bold shrink-0 mt-0.5">✓</span>
                        <span class="leading-snug">{pro}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <!-- Cons Rival B -->
              {compData.rivalB.cons.length > 0 && (
                <div class="pt-3 border-t border-cyan-500/15">
                  <div class="text-xs font-bold text-rose-400 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                    <span>✕</span> Points faibles
                  </div>
                  <ul class="space-y-2">
                    {compData.rivalB.cons.map(con => (
                      <li class="flex items-start gap-2 text-xs sm:text-sm text-[var(--color-text)]">
                        <span class="text-rose-400 font-bold shrink-0 mt-0.5">✕</span>
                        <span class="leading-snug">{con}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>

          <!-- Points communs ou contexte algérien -->
          {(compData.commonCons.length > 0 || compData.commonPros.length > 0) && (
            <div class="mt-4 p-4 rounded-xl bg-amber-500/10 border border-amber-500/25">
              <div class="flex items-center gap-2 text-amber-300 font-bold text-xs uppercase tracking-wider mb-2">
                <span>🇩🇿</span> Contexte commun & Marché algérien
              </div>
              <ul class="space-y-1.5">
                {[...compData.commonPros, ...compData.commonCons].map(item => (
                  <li class="flex items-start gap-2 text-xs sm:text-sm text-[var(--color-text)]">
                    <span class="text-amber-400 font-bold shrink-0 mt-0.5">•</span>
                    <span class="leading-snug">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <!-- 3. Notes détaillées par critère -->
        {ratingsBreakdown && (
          <div class="mt-8 pt-8 border-t border-[var(--color-border)]">
            <h4 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-4">
              Notes du match par critère
            </h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {ratingsBreakdown.performance !== undefined && (
                <div>
                  <div class="flex justify-between text-xs font-semibold mb-1">
                    <span class="text-[var(--color-text)]">🚀 Performances & Vitesse</span>
                    <span class="text-emerald-400">{ratingsBreakdown.performance} / 10</span>
                  </div>
                  <div class="w-full h-2 rounded-full bg-[var(--color-bg)] overflow-hidden border border-[var(--color-border)]">
                    <div class="h-full bg-emerald-400 rounded-full" style={`width: ${ratingsBreakdown.performance * 10}%;`}></div>
                  </div>
                </div>
              )}

              {ratingsBreakdown.design !== undefined && (
                <div>
                  <div class="flex justify-between text-xs font-semibold mb-1">
                    <span class="text-[var(--color-text)]">🎨 Design & Charnière pliable</span>
                    <span class="text-cyan-400">{ratingsBreakdown.design} / 10</span>
                  </div>
                  <div class="w-full h-2 rounded-full bg-[var(--color-bg)] overflow-hidden border border-[var(--color-border)]">
                    <div class="h-full bg-cyan-400 rounded-full" style={`width: ${ratingsBreakdown.design * 10}%;`}></div>
                  </div>
                </div>
              )}

              {ratingsBreakdown.autonomy !== undefined && (
                <div>
                  <div class="flex justify-between text-xs font-semibold mb-1">
                    <span class="text-[var(--color-text)]">🔋 Autonomie & Gestion thermique</span>
                    <span class="text-amber-400">{ratingsBreakdown.autonomy} / 10</span>
                  </div>
                  <div class="w-full h-2 rounded-full bg-[var(--color-bg)] overflow-hidden border border-[var(--color-border)]">
                    <div class="h-full bg-amber-400 rounded-full" style={`width: ${ratingsBreakdown.autonomy * 10}%;`}></div>
                  </div>
                </div>
              )}

              {ratingsBreakdown.valueForMoney !== undefined && (
                <div>
                  <div class="flex justify-between text-xs font-semibold mb-1">
                    <span class="text-[var(--color-text)]">💰 Rapport Qualité / Prix Algérie</span>
                    <span class="text-purple-400">{ratingsBreakdown.valueForMoney} / 10</span>
                  </div>
                  <div class="w-full h-2 rounded-full bg-[var(--color-bg)] overflow-hidden border border-[var(--color-border)]">
                    <div class="h-full bg-purple-400 rounded-full" style={`width: ${ratingsBreakdown.valueForMoney * 10}%;`}></div>
                  </div>
                </div>
              )}
            </div>
          </div>
        )}

        <!-- 4. FICHE TECHNIQUE FACE-À-FACE (SANS AUCUN TRUNCATE) -->
        {compData.specs.length > 0 && (
          <div class="mt-8 pt-8 border-t border-[var(--color-border)]">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-4">
              <h4 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text)] flex items-center gap-2">
                <span>📊</span> Fiche technique Face-à-Face direct
              </h4>
              <span class="text-xs text-[var(--color-text-muted)]">
                Toutes les caractéristiques sans compromis
              </span>
            </div>

            <!-- Version Tableau Desktop / Tablette (Grand écran) -->
            <div class="hidden sm:block overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg)] shadow-md">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="border-b border-[var(--color-border)] bg-[var(--color-bg-secondary)]/70">
                    <th class="py-3 px-4 text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)] w-1/4">
                      Caractéristique
                    </th>
                    <th class="py-3 px-4 text-xs font-bold uppercase tracking-wider text-indigo-300 bg-indigo-950/20 border-l border-[var(--color-border)] w-3/8">
                      🍎 {compData.rivalA.name}
                    </th>
                    <th class="py-3 px-4 text-xs font-bold uppercase tracking-wider text-cyan-300 bg-cyan-950/20 border-l border-[var(--color-border)] w-3/8">
                      🔷 {compData.rivalB.name}
                    </th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-[var(--color-border)] text-xs sm:text-sm">
                  {compData.specs.map(({ key, valA, valB }) => (
                    <tr class="hover:bg-[var(--color-bg-secondary)]/30 transition-colors">
                      <td class="py-3.5 px-4 font-semibold text-[var(--color-text-muted)] text-xs uppercase tracking-wider">
                        {key}
                      </td>
                      <td class="py-3.5 px-4 text-[var(--color-text)] border-l border-[var(--color-border)] break-words font-medium leading-relaxed">
                        {valA}
                      </td>
                      <td class="py-3.5 px-4 text-[var(--color-text)] border-l border-[var(--color-border)] break-words font-medium leading-relaxed">
                        {valB}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <!-- Version Cartes Mobile (Petit écran) -->
            <div class="sm:hidden space-y-3">
              {compData.specs.map(({ key, valA, valB }) => (
                <div class="p-3.5 rounded-xl bg-[var(--color-bg)] border border-[var(--color-border)] space-y-2">
                  <div class="text-[11px] font-bold uppercase tracking-wider text-[var(--color-text-muted)]">
                    {key}
                  </div>
                  <div class="space-y-1.5 pt-1">
                    <div class="p-2.5 rounded-lg bg-indigo-950/20 border border-indigo-500/20">
                      <span class="text-[10px] font-bold text-indigo-300 uppercase tracking-wider block mb-0.5">
                        🍎 {compData.rivalA.name}
                      </span>
                      <div class="text-xs font-medium text-[var(--color-text)] break-words leading-relaxed">
                        {valA}
                      </div>
                    </div>
                    <div class="p-2.5 rounded-lg bg-cyan-950/20 border border-cyan-500/20">
                      <span class="text-[10px] font-bold text-cyan-300 uppercase tracking-wider block mb-0.5">
                        🔷 {compData.rivalB.name}
                      </span>
                      <div class="text-xs font-medium text-[var(--color-text)] break-words leading-relaxed">
                        {valB}
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </section>
    ) : (
      <!-- MISE EN PAGE STANDARD TEST MONO-PRODUIT -->
      <section class="mb-12 relative overflow-hidden rounded-3xl p-6 sm:p-8 bg-gradient-to-br from-[var(--color-bg-secondary)] via-[var(--color-bg-secondary)]/80 to-[var(--color-bg)] border border-[var(--color-border)] shadow-xl">
        <!-- Glow d'ambiance -->
        <div class="absolute -top-24 -right-24 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-[var(--color-accent)]/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <!-- Image & Badges produit (5 cols) -->
          <div class="lg:col-span-5 flex flex-col items-center">
            <div class="relative w-full aspect-4/3 rounded-2xl overflow-hidden border border-[var(--color-border)] shadow-md bg-black/40 group">
              <img 
                src={image} 
                alt={productName}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute top-3 left-3 bg-black/70 backdrop-blur-md px-3 py-1 rounded-full text-xs font-semibold text-white border border-white/10">
                {brand}
              </div>
              {price && (
                <div class="absolute bottom-3 right-3 bg-emerald-500/90 backdrop-blur-md px-3.5 py-1.5 rounded-full text-xs font-bold text-black shadow-lg">
                  💰 {price}
                </div>
              )}
            </div>
          </div>

          <!-- Jauge radiale & Verdict (7 cols) -->
          <div class="lg:col-span-7 flex flex-col gap-6">
            <div class="flex items-center justify-between sm:justify-start gap-6">
              <div class="relative flex items-center justify-center shrink-0">
                <svg class="w-28 h-28 transform -rotate-90" viewBox="0 0 100 100">
                  <circle cx="50" cy="50" r="42" class="stroke-white/10" stroke-width="8" fill="transparent" />
                  <circle 
                    cx="50" cy="50" r="42" 
                    class="stroke-emerald-400 transition-all duration-1000 ease-out" 
                    stroke-width="8" 
                    stroke-linecap="round" 
                    fill="transparent" 
                    stroke-dasharray={circumference} 
                    stroke-dashoffset={strokeDashoffset} 
                  />
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                  <span class="text-3xl font-black text-[var(--color-text)] tracking-tight">
                    {rating.toFixed(1)}
                  </span>
                  <span class="text-[10px] font-semibold text-[var(--color-text-muted)] uppercase tracking-wider">
                    sur 10
                  </span>
                </div>
              </div>

              <div>
                <div class="text-xs font-bold uppercase tracking-wider text-emerald-400 mb-1">
                  Avis de la rédaction
                </div>
                <h3 class="text-xl sm:text-2xl font-black text-[var(--color-text)]">
                  {rating >= 8.5 ? '⭐ Coup de cœur absolu' : rating >= 7.0 ? '👍 Hautement recommandé' : '⚠️ Intéressant avec réserves'}
                </h3>
                <p class="text-xs text-[var(--color-text-muted)] mt-1">
                  Protocole indépendant : testé en conditions réelles
                </p>
              </div>
            </div>

            <div class="p-4 rounded-xl bg-[var(--color-bg)]/80 border border-[var(--color-border)] text-sm text-[var(--color-text)] leading-relaxed italic">
              « {verdict} »
            </div>

            {buyUrl && (
              <div>
                <a 
                  href={buyUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-6 py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-black font-bold text-sm shadow-lg shadow-emerald-500/20 hover:scale-[1.02] transition-all"
                >
                  <span>{buyLabel}</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            )}
          </div>
        </div>

        <!-- Bento Pros & Cons Classique -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-8 pt-8 border-t border-[var(--color-border)]">
          <div class="p-5 rounded-2xl bg-emerald-500/5 border border-emerald-500/20">
            <div class="flex items-center gap-2 text-emerald-400 font-bold text-sm mb-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
              <span>Ce qu'on adore (Points forts)</span>
            </div>
            <ul class="space-y-2">
              {pros.map(pro => (
                <li class="flex items-start gap-2 text-xs sm:text-sm text-[var(--color-text)]">
                  <span class="text-emerald-400 font-bold mt-0.5">✓</span>
                  <span class="break-words leading-relaxed">{pro}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="p-5 rounded-2xl bg-rose-500/5 border border-rose-500/20">
            <div class="flex items-center gap-2 text-rose-400 font-bold text-sm mb-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
              </svg>
              <span>Ce qui fâche (Points faibles)</span>
            </div>
            <ul class="space-y-2">
              {cons.map(con => (
                <li class="flex items-start gap-2 text-xs sm:text-sm text-[var(--color-text)]">
                  <span class="text-rose-400 font-bold mt-0.5">✕</span>
                  <span class="break-words leading-relaxed">{con}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Critères détaillés -->
        {ratingsBreakdown && (
          <div class="mt-8 pt-8 border-t border-[var(--color-border)]">
            <h4 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-4">
              Notes détaillées par critère
            </h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {ratingsBreakdown.performance !== undefined && (
                <div>
                  <div class="flex justify-between text-xs font-semibold mb-1">
                    <span class="text-[var(--color-text)]">🚀 Performances & Vitesse</span>
                    <span class="text-emerald-400">{ratingsBreakdown.performance} / 10</span>
                  </div>
                  <div class="w-full h-2 rounded-full bg-[var(--color-bg)] overflow-hidden border border-[var(--color-border)]">
                    <div class="h-full bg-emerald-400 rounded-full" style={`width: ${ratingsBreakdown.performance * 10}%;`}></div>
                  </div>
                </div>
              )}

              {ratingsBreakdown.design !== undefined && (
                <div>
                  <div class="flex justify-between text-xs font-semibold mb-1">
                    <span class="text-[var(--color-text)]">🎨 Design & Finitions</span>
                    <span class="text-cyan-400">{ratingsBreakdown.design} / 10</span>
                  </div>
                  <div class="w-full h-2 rounded-full bg-[var(--color-bg)] overflow-hidden border border-[var(--color-border)]">
                    <div class="h-full bg-cyan-400 rounded-full" style={`width: ${ratingsBreakdown.design * 10}%;`}></div>
                  </div>
                </div>
              )}

              {ratingsBreakdown.autonomy !== undefined && (
                <div>
                  <div class="flex justify-between text-xs font-semibold mb-1">
                    <span class="text-[var(--color-text)]">🔋 Autonomie & Chauffe</span>
                    <span class="text-amber-400">{ratingsBreakdown.autonomy} / 10</span>
                  </div>
                  <div class="w-full h-2 rounded-full bg-[var(--color-bg)] overflow-hidden border border-[var(--color-border)]">
                    <div class="h-full bg-amber-400 rounded-full" style={`width: ${ratingsBreakdown.autonomy * 10}%;`}></div>
                  </div>
                </div>
              )}

              {ratingsBreakdown.valueForMoney !== undefined && (
                <div>
                  <div class="flex justify-between text-xs font-semibold mb-1">
                    <span class="text-[var(--color-text)]">💰 Rapport Qualité / Prix</span>
                    <span class="text-purple-400">{ratingsBreakdown.valueForMoney} / 10</span>
                  </div>
                  <div class="w-full h-2 rounded-full bg-[var(--color-bg)] overflow-hidden border border-[var(--color-border)]">
                    <div class="h-full bg-purple-400 rounded-full" style={`width: ${ratingsBreakdown.valueForMoney * 10}%;`}></div>
                  </div>
                </div>
              )}
            </div>
          </div>
        )}

        <!-- FICHE TECHNIQUE RÉSUMÉE STANDARD (SANS TRUNCATE) -->
        {specs && Object.keys(specs).length > 0 && (
          <div class="mt-8 pt-8 border-t border-[var(--color-border)]">
            <h4 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-4">
              Fiche technique clé
            </h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
              {Object.entries(specs).map(([specKey, specVal]) => (
                <div class="p-3.5 rounded-xl bg-[var(--color-bg)] border border-[var(--color-border)] flex flex-col justify-between">
                  <div class="text-[11px] font-semibold text-[var(--color-text-muted)] uppercase">
                    {specKey}
                  </div>
                  <div class="text-xs sm:text-sm font-bold text-[var(--color-text)] mt-1 break-words leading-snug">
                    {specVal}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </section>
    )}

    <!-- Table des matières -->
    {headings && headings.length > 0 && (
      <div class="mb-10">
        <TableOfContents headings={headings} />
      </div>
    )}

    <!-- Corps de l'article Markdown -->
    <div id="article-content" class="prose prose-lg dark:prose-invert max-w-none mb-12">
      <slot />
    </div>

    <!-- Réactions & Partage -->
    <div class="space-y-6 pt-8 border-t border-[var(--color-border)]">
      <PostReactions slug={test.slug} />
      <ShareButtons url={canonicalURL.toString()} title={title} />
    </div>

    <!-- Bio de l'auteur -->
    <div class="mt-12 p-6 rounded-2xl bg-[var(--color-bg-secondary)] border border-[var(--color-border)] flex flex-col sm:flex-row items-center gap-4">
      <img 
        src={authorImage || '/malmcat2.webp'} 
        alt={author} 
        class="w-16 h-16 rounded-full border-2 border-[var(--color-accent)] object-cover"
      />
      <div class="text-center sm:text-left">
        <h4 class="font-bold text-[var(--color-text)]">{author}</h4>
        <p class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-1">
          {authorBio || "Fondateur de Malmeu. Je teste le matériel et les logiciels avec les yeux d'un développeur exigeant et sans concessions marketing."}
        </p>
      </div>
    </div>

    <!-- Navigation Tests Suivant / Précédent -->
    <nav class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-8">
      {prevTest ? (
        <a href={`/tests/${prevTest.slug}`} class="p-4 rounded-xl bg-[var(--color-bg-secondary)] border border-[var(--color-border)] hover:border-[var(--color-accent)] transition-all group">
          <div class="text-xs text-[var(--color-text-muted)]">← Test précédent</div>
          <div class="font-semibold text-sm text-[var(--color-text)] group-hover:text-[var(--color-accent)] mt-1 line-clamp-1">{prevTest.data.title}</div>
        </a>
      ) : <div />}
      {nextTest ? (
        <a href={`/tests/${nextTest.slug}`} class="p-4 rounded-xl bg-[var(--color-bg-secondary)] border border-[var(--color-border)] hover:border-[var(--color-accent)] transition-all text-right group">
          <div class="text-xs text-[var(--color-text-muted)]">Test suivant →</div>
          <div class="font-semibold text-sm text-[var(--color-text)] group-hover:text-[var(--color-accent)] mt-1 line-clamp-1">{nextTest.data.title}</div>
        </a>
      ) : <div />}
    </nav>

    <!-- Newsletter & Commentaires -->
    <div class="mt-12">
      <Newsletter />
    </div>

    <div class="mt-12">
      <Comments slug={test.slug} title={title} />
    </div>
  </article>

  <!-- Script pour le mode Zen & la barre de progression -->
  <script is:inline>
    // Barre de défilement
    window.addEventListener('scroll', () => {
      const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
      const bar = document.getElementById('reading-progress-bar');
      if (bar) bar.style.width = scrolled + '%';
    });

    // Mode Zen
    const zenBtn = document.getElementById('zen-toggle-btn');
    const exitZenBtn = document.getElementById('zen-exit-btn');
    const zenToolbar = document.getElementById('zen-toolbar');

    function toggleZenMode(enable) {
      if (enable) {
        document.body.classList.add('zen-active');
        if (zenToolbar) {
          zenToolbar.classList.remove('hidden');
          zenToolbar.classList.add('flex');
        }
      } else {
        document.body.classList.remove('zen-active');
        if (zenToolbar) {
          zenToolbar.classList.remove('flex');
          zenToolbar.classList.add('hidden');
        }
      }
    }

    if (zenBtn) zenBtn.addEventListener('click', () => toggleZenMode(true));
    if (exitZenBtn) exitZenBtn.addEventListener('click', () => toggleZenMode(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') toggleZenMode(false);
    });
  </script>
</BaseLayout>
