---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Comments from '../components/Comments.astro';
import ShareButtons from '../components/ShareButtons.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import Newsletter from '../components/Newsletter.astro';
import PostReactions from '../components/PostReactions.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Analytics from '@vercel/analytics/astro'

const currentUrl = Astro.url.href;

interface Props {
  post: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
  prevPost?: CollectionEntry<'blog'>;
  nextPost?: CollectionEntry<'blog'>;
}

const { post, headings, prevPost, nextPost } = Astro.props;
const { title, description, publishDate, category, tags, image, sponsored, sponsorName, sponsorUrl, sponsorLogo, author, authorImage, authorBio } = post.data;

// Calculate reading time
const content = post.body || '';
const wordsPerMinute = 200;
const wordCount = content.split(/\s+/).length;
const readingTime = Math.ceil(wordCount / wordsPerMinute);

// Récupérer un index léger des articles pour les prévisualisations de liens au survol
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const blogPreviews = allPosts.map(p => ({
  slug: p.slug,
  title: p.data.title,
  category: p.data.category,
  image: p.data.image,
  description: p.data.description,
}));
---

<BaseLayout 
  title={`${title} | Blog`}
  description={description}
  image={image}
  type="article"
  publishDate={publishDate}
  tags={tags}
  category={category}
  readingTime={readingTime}
  wordCount={wordCount}
>
  <!-- Barre de progression de lecture -->
  <div id="reading-progress-bar" class="fixed top-0 left-0 h-1 bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-orange)] z-50 transition-all duration-75" style="width: 0%;"></div>

  <!-- Barre d'outils Mode Zen (Flottante) -->
  <div id="zen-toolbar" class="fixed top-4 right-4 z-50 hidden items-center gap-2 p-2 bg-[var(--color-bg-secondary)]/90 backdrop-blur-md border border-[var(--color-accent)]/30 rounded-2xl shadow-2xl">
    <button id="zen-font-down" class="px-2.5 py-1 text-xs font-bold bg-[var(--color-bg)] text-[var(--color-text)] rounded-lg hover:bg-[var(--color-accent)]/20 cursor-pointer" title="Diminuer la police">A-</button>
    <button id="zen-font-up" class="px-2.5 py-1 text-xs font-bold bg-[var(--color-bg)] text-[var(--color-text)] rounded-lg hover:bg-[var(--color-accent)]/20 cursor-pointer" title="Agrandir la police">A+</button>
    <button id="zen-exit-btn" class="px-3 py-1 text-xs font-semibold bg-rose-500/20 text-rose-300 border border-rose-500/30 rounded-lg hover:bg-rose-500/30 cursor-pointer" title="Quitter (Échap)">✕ Quitter Zen</button>
  </div>

  <!-- Popover Link Preview (Prévisualisation des liens internes) -->
  <div id="link-preview-card" class="fixed hidden z-50 w-72 p-3 bg-[var(--color-bg-secondary)] border border-[var(--color-accent)]/40 rounded-xl shadow-2xl backdrop-blur-md pointer-events-none transition-opacity duration-150 text-xs">
    <img id="preview-img" src="" alt="" class="w-full h-28 object-cover rounded-lg mb-2" />
    <span id="preview-cat" class="px-2 py-0.5 bg-[var(--color-accent)]/15 text-[var(--color-accent)] font-semibold rounded text-[10px]"></span>
    <h4 id="preview-title" class="font-bold text-sm text-[var(--color-text)] mt-1 line-clamp-2"></h4>
    <p id="preview-desc" class="text-[var(--color-text-muted)] mt-1 line-clamp-2"></p>
  </div>

  <!-- Bouton Retour en haut -->
  <button 
    id="scroll-to-top" 
    class="fixed bottom-6 right-6 p-3 rounded-xl bg-[var(--color-bg-secondary)] border border-[var(--color-accent)]/30 text-[var(--color-text)] shadow-xl opacity-0 pointer-events-none transition-all duration-300 hover:bg-[var(--color-accent)] hover:text-[var(--color-bg)] z-40 flex items-center justify-center cursor-pointer"
    aria-label="Retour en haut"
    title="Retour en haut"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
    </svg>
  </button>

  <article class="max-w-4xl mx-auto px-4 py-12">
    <!-- Breadcrumbs -->
    <nav class="mb-8 text-sm" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-[var(--color-text-muted)]" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="hover:text-[var(--color-accent)] transition-colors">
            <span itemprop="name">Accueil</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <li class="text-[var(--color-text-muted)]">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/blog" itemprop="item" class="hover:text-[var(--color-accent)] transition-colors">
            <span itemprop="name">Blog</span>
          </a>
          <meta itemprop="position" content="2" />
        </li>
        <li class="text-[var(--color-text-muted)]">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="text-[var(--color-accent)]">{title}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="mb-12">
      <div class="flex items-center gap-4 mb-4 flex-wrap">
        {sponsored && (
          <span class="px-3 py-1 bg-gradient-to-r from-amber-500 to-orange-500 text-white rounded-full text-sm font-medium">
            💰 Sponsorisé
          </span>
        )}
        <a 
          href={`/blog/category/${category.toLowerCase()}`}
          class="px-3 py-1 bg-[var(--color-accent)] text-[var(--color-bg)] rounded-full text-sm font-medium hover:opacity-90 transition-opacity"
        >
          {category}
        </a>
        <span class="text-[var(--color-text-muted)] text-sm">
          {readingTime} min de lecture
        </span>
        <span class="text-[var(--color-text-muted)] text-sm flex items-center gap-1" title="Vues réelles">
          <span>👁️</span>
          <span id="article-views-count">-</span> vues
        </span>
        <button 
          id="zen-mode-toggle"
          class="inline-flex items-center gap-1.5 px-3 py-1 bg-[var(--color-bg-secondary)] hover:bg-[var(--color-accent)]/20 border border-[var(--color-accent)]/25 text-[var(--color-text)] hover:text-[var(--color-accent)] rounded-full text-xs font-semibold cursor-pointer transition-all duration-200"
          title="Activer la lecture sans distraction (Touche Échap pour quitter)"
        >
          <span>🧘</span> Mode Zen
        </button>
      </div>
      
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-[var(--color-text)]">
        {title}
      </h1>
      
      <p class="text-xl text-[var(--color-text-muted)] mb-6">
        {description}
      </p>
      
      <div class="flex items-center justify-between flex-wrap gap-4">
        <!-- Auteur -->
        <div class="flex items-center gap-3">
          {authorImage ? (
            <img src={authorImage} alt={author} class="w-10 h-10 rounded-full object-cover" />
          ) : (
            <div class="w-10 h-10 rounded-full bg-[var(--color-accent)] flex items-center justify-center text-[var(--color-bg)] font-bold">
              {author?.charAt(0) || 'M'}
            </div>
          )}
          <div>
            <span class="text-sm font-medium text-[var(--color-text)]">{author || 'Malmeu'}</span>
            <time datetime={publishDate.toISOString()} class="block text-xs text-[var(--color-text-muted)]">
              {publishDate.toLocaleDateString('fr-FR', { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric' 
              })}
            </time>
          </div>
        </div>
        <ShareButtons title={title} url={currentUrl} />
      </div>
      
      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {tags.map((tag: string) => (
            <a 
              href={`/blog/tag/${tag.toLowerCase().trim()}`} 
              class="px-2.5 py-1 bg-[var(--color-bg-secondary)] hover:bg-[var(--color-accent)]/15 text-[var(--color-text-muted)] hover:text-[var(--color-accent)] rounded-lg text-xs font-medium transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <!-- Sponsor Banner -->
    {sponsored && sponsorName && (
      <div class="mb-8 p-4 bg-gradient-to-r from-amber-500/10 to-orange-500/10 border border-amber-500/30 rounded-xl">
        <div class="flex items-center gap-4">
          {sponsorLogo && (
            <img src={sponsorLogo} alt={sponsorName} class="h-10 w-auto" />
          )}
          <div class="flex-1">
            <p class="text-sm text-[var(--color-text-muted)]">
              Cet article est sponsorisé par 
              {sponsorUrl ? (
                <a href={sponsorUrl} target="_blank" rel="noopener sponsored" class="font-semibold text-amber-500 hover:text-amber-400 transition-colors">
                  {sponsorName}
                </a>
              ) : (
                <span class="font-semibold text-amber-500">{sponsorName}</span>
              )}
            </p>
          </div>
        </div>
      </div>
    )}

    <!-- Cover Image -->
    {image && (
      <img 
        src={image} 
        alt={title}
        class="w-full h-64 md:h-96 object-cover rounded-xl mb-12"
      />
    )}

    <!-- Content with TOC -->
    <div class="lg:grid lg:grid-cols-[1fr_250px] lg:gap-12">
      <div class="prose prose-lg max-w-none">
        <slot />
      </div>
      
      {headings.length > 0 && (
        <aside class="hidden lg:block">
          <div class="sticky top-24">
            <TableOfContents headings={headings} />
          </div>
        </aside>
      )}
    </div>

    <!-- Reactions -->
    <div id="reactions-section" class="mt-12 pt-8 border-t border-[var(--color-bg-secondary)]">
      <PostReactions slug={post.slug} />
    </div>

    <!-- Related Posts -->
    <div id="related-posts-section">
      <RelatedPosts 
        currentSlug={post.slug} 
        currentTags={tags || []} 
        currentCategory={category} 
      />
    </div>

    <!-- Newsletter -->
    <div id="newsletter-section">
      <Newsletter />
    </div>

    <!-- Navigation -->
    <nav id="article-nav" class="mt-16 pt-8 border-t border-[var(--color-bg-secondary)]">
      <div class="flex justify-between items-center">
        {prevPost ? (
          <a 
            href={`/blog/${prevPost.slug}`}
            class="group flex flex-col items-start max-w-[45%]"
          >
            <span class="text-sm text-[var(--color-text-muted)] mb-1">← Article précédent</span>
            <span class="text-[var(--color-accent)] group-hover:text-[var(--color-accent-orange)] transition-colors font-medium truncate w-full">
              {prevPost.data.title}
            </span>
          </a>
        ) : <div />}
        
        {nextPost ? (
          <a 
            href={`/blog/${nextPost.slug}`}
            class="group flex flex-col items-end max-w-[45%]"
          >
            <span class="text-sm text-[var(--color-text-muted)] mb-1">Article suivant →</span>
            <span class="text-[var(--color-accent)] group-hover:text-[var(--color-accent-orange)] transition-colors font-medium truncate w-full text-right">
              {nextPost.data.title}
            </span>
          </a>
        ) : <div />}
      </div>
    </nav>
  </article>
  
  <!-- Comments Section -->
  <Comments slug={post.slug} title={post.data.title} />
  <Analytics />

  <script is:inline define:vars={{ slug: post.slug }}>
    (function() {
      const viewsCountEl = document.getElementById('article-views-count');
      if (!slug) return;

      const sessionKey = 'viewed_article_' + slug;
      const isAdmin = localStorage.getItem('admin_session') === 'authenticated';
      const alreadyViewedInSession = sessionStorage.getItem(sessionKey);

      // Si l'utilisateur est admin ou a déjà vu l'article dans cette session, on récupère juste le compteur
      if (isAdmin || alreadyViewedInSession) {
        fetch('/api/views?slug=' + encodeURIComponent(slug))
          .then(res => res.json())
          .then(data => {
            if (viewsCountEl && data && typeof data.views === 'number') {
              viewsCountEl.textContent = new Intl.NumberFormat('fr-FR').format(data.views);
            }
          })
          .catch(() => {});
      } else {
        // Enregistrer la vue réelle (une seule fois par session visiteur)
        sessionStorage.setItem(sessionKey, '1');
        fetch('/api/views', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug: slug })
        })
          .then(res => res.json())
          .then(data => {
            if (viewsCountEl && data && typeof data.views === 'number') {
              viewsCountEl.textContent = new Intl.NumberFormat('fr-FR').format(data.views);
            }
          })
          .catch(() => {});
      }

      // Bouton scroll to top
      const scrollBtn = document.getElementById('scroll-to-top');
      const progressBar = document.getElementById('reading-progress-bar');

      window.addEventListener('scroll', function() {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const progress = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
        
        if (progressBar) {
          progressBar.style.width = progress + '%';
        }

        if (scrollBtn) {
          if (scrollTop > 400) {
            scrollBtn.classList.remove('opacity-0', 'pointer-events-none');
            scrollBtn.classList.add('opacity-100', 'pointer-events-auto');
          } else {
            scrollBtn.classList.add('opacity-0', 'pointer-events-none');
            scrollBtn.classList.remove('opacity-100', 'pointer-events-auto');
          }
        }
      }, { passive: true });

      if (scrollBtn) {
        scrollBtn.addEventListener('click', function() {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      // Ajout automatique du bouton "Copier" sur chaque bloc de code
      const preBlocks = document.querySelectorAll('.prose pre');
      preBlocks.forEach(function(pre) {
        pre.style.position = 'relative';
        
        const copyBtn = document.createElement('button');
        copyBtn.className = 'copy-code-btn absolute top-2 right-2 px-2.5 py-1 text-xs rounded-md bg-white/10 hover:bg-white/20 text-gray-300 hover:text-white transition-all duration-150 backdrop-blur-sm border border-white/10 flex items-center gap-1 cursor-pointer';
        copyBtn.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg> <span>Copier</span>';
        
        copyBtn.addEventListener('click', function() {
          const codeEl = pre.querySelector('code');
          const codeText = codeEl ? codeEl.innerText : pre.innerText;
          
          navigator.clipboard.writeText(codeText).then(function() {
            copyBtn.innerHTML = '<svg class="w-3.5 h-3.5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> <span class="text-green-400 font-medium">Copié !</span>';
            setTimeout(function() {
              copyBtn.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg> <span>Copier</span>';
            }, 2000);
          }).catch(function() {});
        });

        pre.appendChild(copyBtn);
      });

      // --- LOGIQUE MODE ZEN ---
      const zenToggle = document.getElementById('zen-mode-toggle');
      const zenToolbar = document.getElementById('zen-toolbar');
      const zenExit = document.getElementById('zen-exit-btn');
      const zenFontUp = document.getElementById('zen-font-up');
      const zenFontDown = document.getElementById('zen-font-down');
      const proseEl = document.querySelector('.prose');

      let currentFontSize = 18;

      function toggleZenMode(enable) {
        if (enable) {
          document.body.classList.add('zen-mode-active');
          if (zenToolbar) zenToolbar.classList.remove('hidden');
          if (zenToolbar) zenToolbar.classList.add('flex');
        } else {
          document.body.classList.remove('zen-mode-active');
          if (zenToolbar) zenToolbar.classList.add('hidden');
          if (zenToolbar) zenToolbar.classList.remove('flex');
        }
      }

      if (zenToggle) zenToggle.addEventListener('click', () => toggleZenMode(true));
      if (zenExit) zenExit.addEventListener('click', () => toggleZenMode(false));

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && document.body.classList.contains('zen-mode-active')) {
          toggleZenMode(false);
        }
      });

      if (zenFontUp && proseEl) {
        zenFontUp.addEventListener('click', () => {
          if (currentFontSize < 26) {
            currentFontSize += 2;
            proseEl.style.fontSize = currentFontSize + 'px';
          }
        });
      }

      if (zenFontDown && proseEl) {
        zenFontDown.addEventListener('click', () => {
          if (currentFontSize > 14) {
            currentFontSize -= 2;
            proseEl.style.fontSize = currentFontSize + 'px';
          }
        });
      }

      // --- LOGIQUE LINK PREVIEWS ---
      const previewCard = document.getElementById('link-preview-card');
      const previewImg = document.getElementById('preview-img');
      const previewCat = document.getElementById('preview-cat');
      const previewTitle = document.getElementById('preview-title');
      const previewDesc = document.getElementById('preview-desc');
      const previewsData = window.__BLOG_PREVIEWS__ || {};

      const contentLinks = document.querySelectorAll('.prose a');
      contentLinks.forEach(link => {
        const href = link.getAttribute('href');
        if (!href || !href.includes('/blog/')) return;

        const match = href.match(/\/blog\/([^#/?]+)/);
        if (!match) return;
        const targetSlug = match[1];
        const previewInfo = previewsData[targetSlug];
        if (!previewInfo) return;

        link.addEventListener('mouseenter', (e) => {
          if (window.innerWidth < 768) return; // Sur desktop uniquement
          previewImg.src = previewInfo.image || '/og-default.svg';
          previewCat.textContent = previewInfo.category || 'Article';
          previewTitle.textContent = previewInfo.title;
          previewDesc.textContent = previewInfo.description || '';

          const rect = link.getBoundingClientRect();
          const top = rect.top - 220 > 10 ? rect.top - 220 : rect.bottom + 10;
          const left = Math.min(rect.left, window.innerWidth - 300);

          previewCard.style.top = top + 'px';
          previewCard.style.left = left + 'px';
          previewCard.classList.remove('hidden');
        });

        link.addEventListener('mouseleave', () => {
          previewCard.classList.add('hidden');
        });
      });
    })();
  </script>

  <script is:inline define:vars={{ blogPreviews }}>
    window.__BLOG_PREVIEWS__ = {};
    if (Array.isArray(blogPreviews)) {
      blogPreviews.forEach(p => {
        window.__BLOG_PREVIEWS__[p.slug] = p;
      });
    }
  </script>

  <style is:global>
    body.zen-mode-active header,
    body.zen-mode-active footer,
    body.zen-mode-active aside,
    body.zen-mode-active #reactions-section,
    body.zen-mode-active #related-posts-section,
    body.zen-mode-active #newsletter-section,
    body.zen-mode-active #article-nav,
    body.zen-mode-active #comments-section,
    body.zen-mode-active #scroll-to-top {
      display: none !important;
    }
    body.zen-mode-active {
      background-color: #07090e !important;
    }
    body.zen-mode-active article {
      max-width: 740px !important;
      margin: 0 auto !important;
      padding-top: 5rem !important;
      line-height: 1.9 !important;
    }
  </style>
</BaseLayout>
